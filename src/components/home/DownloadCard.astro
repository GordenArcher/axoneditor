---
import type { ReleaseAsset } from "@data/releases";

interface Props {
  assets: ReleaseAsset[];
  releaseTag?: string;
  compact?: boolean;
}

const { assets, releaseTag, compact = false } = Astro.props;

function platformKey(platform: string) {
  const value = platform.toLowerCase();

  if (value.includes("apple silicon")) return "mac-arm";
  if (value.includes("intel")) return "mac-intel";
  if (value.includes("windows")) return "windows";
  if (value.includes("linux") || value.includes("debian") || value.includes("ubuntu")) return "linux";
  return "other";
}

function platformIcon(platform: string) {
  const key = platformKey(platform);

  if (key === "windows") return "windows";
  if (key === "linux") return "linux";
  if (key.startsWith("mac")) return "apple";
  return "download";
}

function shortPlatform(platform: string) {
  if (platform === "macOS Apple Silicon") return "Mac Apple Silicon";
  if (platform === "macOS Intel") return "Mac Intel";
  return platform;
}

const glyphs: Record<string, string> = {
  apple: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16.6 13.2c0-2.1 1.7-3.1 1.8-3.2-1-1.5-2.6-1.7-3.1-1.8-1.3-.1-2.6.8-3.2.8-.7 0-1.7-.8-2.8-.8-1.4 0-2.8.9-3.5 2.2-1.5 2.6-.4 6.4 1.1 8.5.7 1 1.6 2.2 2.7 2.1 1.1 0 1.5-.7 2.8-.7s1.7.7 2.8.7c1.2 0 1.9-1 2.6-2.1.8-1.2 1.2-2.4 1.2-2.5 0 0-2.4-.9-2.4-3.2ZM14.5 6.8c.6-.7 1-1.7.9-2.7-.9 0-1.9.6-2.5 1.3-.6.7-1 1.7-.9 2.7 1 0 1.9-.5 2.5-1.3Z"/></svg>`,
  windows: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5.1 10.7 4v7.3H3V5.1Zm0 7.6h7.7V20L3 18.9v-6.2Zm9-8.9L21 2.5v8.8h-9V3.8Zm0 8.9h9v8.8l-9-1.3v-7.5Z"/></svg>`,
  linux: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5c-2.1 0-3.6 1.6-3.6 4.1 0 1.3.4 2.5.8 3.6-.9 1.3-1.6 3-2 4.8-.6.3-1.5 1-2.2 2.1-.7 1.2-.8 2.5-.3 3 .5.6 1.7.2 2.9-.6.4.8 1.7 1.4 4.4 1.4s4-.6 4.4-1.4c1.2.8 2.4 1.2 2.9.6.5-.5.4-1.8-.3-3-.7-1.1-1.6-1.8-2.2-2.1-.4-1.8-1.1-3.5-2-4.8.4-1.1.8-2.3.8-3.6 0-2.5-1.5-4.1-3.6-4.1Zm-1.4 4.3c.4 0 .7.4.7.9s-.3.9-.7.9-.7-.4-.7-.9.3-.9.7-.9Zm2.8 0c.4 0 .7.4.7.9s-.3.9-.7.9-.7-.4-.7-.9.3-.9.7-.9ZM12 9.2c.6 0 1 .3 1 .7 0 .5-.4.9-1 .9s-1-.4-1-.9c0-.4.4-.7 1-.7Z"/></svg>`,
  download: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 3h2v9.2l3.3-3.3 1.4 1.4L12 16l-5.7-5.7 1.4-1.4 3.3 3.3V3Zm-7 14h2v3h16v-3h2v5H4v-5Z"/></svg>`,
};
---

<div class:list={["relative z-40 block", compact ? "max-w-56" : "max-w-72"]} data-platform-download>
  {assets.length ? (
    <>
      <div class="group relative mb-2" data-platform-picker>
        <button
          type="button"
          class="relative grid min-h-10 w-full grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-3 rounded-lg border border-white/10 bg-transparent px-3 py-2 text-left text-axon-text transition hover:border-white/25 aria-expanded:border-white/25"
          data-platform-trigger
          aria-haspopup="listbox"
          aria-expanded="false"
        >
          <span data-platform-primary-icon class="grid h-4 w-4 shrink-0 place-items-center [&_svg]:h-4 [&_svg]:w-4 [&_svg]:fill-current" set:html={glyphs[platformIcon(assets[0].platform)] ?? glyphs.download}></span>
          <span class="min-w-0">
            <span class="block text-sm font-semibold text-zinc-100" data-platform-selected-label>
              {shortPlatform(assets[0].platform)}
            </span>
            <span class="block truncate text-xs text-axon-muted" data-platform-selected-file>
              {assets[0].name}
            </span>
          </span>
          <span class="text-lg leading-none text-axon-muted" aria-hidden="true">⌄</span>
        </button>

        <div class="absolute inset-x-0 top-[calc(100%+0.35rem)] z-50 hidden overflow-hidden rounded-lg border border-white/15 bg-black shadow-2xl shadow-black/50 group-data-[open]:block" data-platform-menu role="listbox" aria-label="Select platform download">
          {assets.map((asset, index) => (
            <button
              type="button"
              class="grid min-h-14 w-full grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-3 border-b border-white/10 bg-transparent px-3 py-2 text-left text-axon-text last:border-b-0 hover:bg-white/[0.06] aria-selected:bg-white/[0.06]"
              role="option"
              aria-selected={index === 0 ? "true" : "false"}
              data-platform-option
              data-platform-key={platformKey(asset.platform)}
              data-platform-label={shortPlatform(asset.platform)}
              data-platform-icon={platformIcon(asset.platform)}
              data-platform-url={asset.downloadUrl}
              data-platform-file={asset.name}
            >
              <span class="grid h-4 w-4 shrink-0 place-items-center [&_svg]:h-4 [&_svg]:w-4 [&_svg]:fill-current" set:html={glyphs[platformIcon(asset.platform)] ?? glyphs.download}></span>
              <span class="min-w-0">
                <span class="block text-sm font-semibold text-zinc-100">{shortPlatform(asset.platform)}</span>
                <span class="block truncate text-xs text-axon-muted">{asset.name}</span>
              </span>
              {asset.size > 0 && (
                <span class="text-xs text-axon-muted">{(asset.size / 1024 / 1024).toFixed(1)} MB</span>
              )}
            </button>
          ))}
        </div>
      </div>
      <a
        href={assets[0].downloadUrl}
        class="inline-flex min-h-9 items-center gap-2 rounded-md bg-axon-text px-4 py-2 text-sm font-medium text-axon-bg transition hover:opacity-90"
        data-platform-primary
      >
        <span data-platform-primary-label>Download for {shortPlatform(assets[0].platform)}</span>
      </a>
      {releaseTag && (
        <p class="text-xs text-axon-muted">
          Latest release: <span class="font-semibold text-zinc-100">{releaseTag}</span>
        </p>
      )}
    </>
  ) : (
    <a href="/releases" class="inline-flex items-center gap-2 rounded-md border border-axon-border bg-transparent px-4 py-2 text-sm font-medium text-axon-text transition hover:bg-axon-hover">
      View release assets
    </a>
  )}
</div>

<script type="module">
  const glyphs = {
    apple: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16.6 13.2c0-2.1 1.7-3.1 1.8-3.2-1-1.5-2.6-1.7-3.1-1.8-1.3-.1-2.6.8-3.2.8-.7 0-1.7-.8-2.8-.8-1.4 0-2.8.9-3.5 2.2-1.5 2.6-.4 6.4 1.1 8.5.7 1 1.6 2.2 2.7 2.1 1.1 0 1.5-.7 2.8-.7s1.7.7 2.8.7c1.2 0 1.9-1 2.6-2.1.8-1.2 1.2-2.4 1.2-2.5 0 0-2.4-.9-2.4-3.2ZM14.5 6.8c.6-.7 1-1.7.9-2.7-.9 0-1.9.6-2.5 1.3-.6.7-1 1.7-.9 2.7 1 0 1.9-.5 2.5-1.3Z"/></svg>`,
    windows: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5.1 10.7 4v7.3H3V5.1Zm0 7.6h7.7V20L3 18.9v-6.2Zm9-8.9L21 2.5v8.8h-9V3.8Zm0 8.9h9v8.8l-9-1.3v-7.5Z"/></svg>`,
    linux: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5c-2.1 0-3.6 1.6-3.6 4.1 0 1.3.4 2.5.8 3.6-.9 1.3-1.6 3-2 4.8-.6.3-1.5 1-2.2 2.1-.7 1.2-.8 2.5-.3 3 .5.6 1.7.2 2.9-.6.4.8 1.7 1.4 4.4 1.4s4-.6 4.4-1.4c1.2.8 2.4 1.2 2.9.6.5-.5.4-1.8-.3-3-.7-1.1-1.6-1.8-2.2-2.1-.4-1.8-1.1-3.5-2-4.8.4-1.1.8-2.3.8-3.6 0-2.5-1.5-4.1-3.6-4.1Zm-1.4 4.3c.4 0 .7.4.7.9s-.3.9-.7.9-.7-.4-.7-.9.3-.9.7-.9Zm2.8 0c.4 0 .7.4.7.9s-.3.9-.7.9-.7-.4-.7-.9.3-.9.7-.9ZM12 9.2c.6 0 1 .3 1 .7 0 .5-.4.9-1 .9s-1-.4-1-.9c0-.4.4-.7 1-.7Z"/></svg>`,
    download: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 3h2v9.2l3.3-3.3 1.4 1.4L12 16l-5.7-5.7 1.4-1.4 3.3 3.3V3Zm-7 14h2v3h16v-3h2v5H4v-5Z"/></svg>`,
  };

  const detectPlatform = async () => {
    const nav = navigator;
    const uaData = nav.userAgentData;
    const platform = (uaData?.platform || nav.platform || nav.userAgent || "").toLowerCase();
    const userAgent = (nav.userAgent || "").toLowerCase();

    if (platform.includes("win") || userAgent.includes("windows")) return "windows";
    if (platform.includes("linux") || userAgent.includes("linux")) return "linux";
    if (platform.includes("mac") || userAgent.includes("mac os")) {
      const highEntropy = uaData?.getHighEntropyValues
        ? await uaData.getHighEntropyValues(["architecture"]).catch(() => null)
        : null;
      const architecture = highEntropy?.architecture?.toLowerCase() || "";
      return architecture.includes("x86") ? "mac-intel" : "mac-arm";
    }

    return "other";
  };

  const selectOption = (root, platform) => {
    const options = Array.from(root.querySelectorAll("[data-platform-option]"));
    return (
      options.find((option) => option.dataset.platformKey === platform)
      || (platform === "mac-arm" ? options.find((option) => option.dataset.platformKey === "mac-intel") : null)
      || (platform === "mac-intel" ? options.find((option) => option.dataset.platformKey === "mac-arm") : null)
      || options[0]
    );
  };

  const closePicker = (root) => {
    const picker = root.querySelector("[data-platform-picker]");
    const trigger = root.querySelector("[data-platform-trigger]");
    picker?.removeAttribute("data-open");
    trigger?.setAttribute("aria-expanded", "false");
  };

  const openPicker = (root) => {
    const picker = root.querySelector("[data-platform-picker]");
    const trigger = root.querySelector("[data-platform-trigger]");
    picker?.setAttribute("data-open", "");
    trigger?.setAttribute("aria-expanded", "true");
  };

  const syncDownload = (root) => {
    const primary = root.querySelector("[data-platform-primary]");
    const label = root.querySelector("[data-platform-primary-label]");
    const icon = root.querySelector("[data-platform-primary-icon]");
    const selectedLabel = root.querySelector("[data-platform-selected-label]");
    const selectedFile = root.querySelector("[data-platform-selected-file]");
    const option = root.querySelector('[data-platform-option][aria-selected="true"]');

    if (!(primary instanceof HTMLAnchorElement) || !(option instanceof HTMLElement)) return;

    primary.href = option.dataset.platformUrl || "#";
    if (label) label.textContent = `Download for ${option.dataset.platformLabel || "your platform"}`;
    if (icon) icon.innerHTML = glyphs[option.dataset.platformIcon || "download"] || glyphs.download;
    if (selectedLabel) selectedLabel.textContent = option.dataset.platformLabel || "Download";
    if (selectedFile) selectedFile.textContent = option.dataset.platformFile || "";
  };

  const applyDetectedDownloads = async () => {
    const platform = await detectPlatform();

    document.querySelectorAll("[data-platform-download]").forEach((root) => {
      const detected = selectOption(root, platform);

      if (detected instanceof HTMLElement) {
        root.querySelectorAll("[data-platform-option]").forEach((option) => {
          option.setAttribute("aria-selected", String(option === detected));
        });
      }

      syncDownload(root);
    });
  };

  if (!window.__axonPlatformDropdownBound) {
    window.__axonPlatformDropdownBound = true;

    document.addEventListener("click", (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const root = target?.closest("[data-platform-download]");
      const trigger = target?.closest("[data-platform-trigger]");
      const option = target?.closest("[data-platform-option]");

      document.querySelectorAll("[data-platform-download]").forEach((candidate) => {
        if (candidate !== root) closePicker(candidate);
      });

      if (root && trigger) {
        const picker = root.querySelector("[data-platform-picker]");
        if (picker?.hasAttribute("data-open")) {
          closePicker(root);
        } else {
          openPicker(root);
        }
        return;
      }

      if (root && option instanceof HTMLElement) {
        root.querySelectorAll("[data-platform-option]").forEach((item) => {
          item.setAttribute("aria-selected", String(item === option));
        });
        syncDownload(root);
        closePicker(root);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      document.querySelectorAll("[data-platform-download]").forEach(closePicker);
    });
  }

  applyDetectedDownloads();
</script>
