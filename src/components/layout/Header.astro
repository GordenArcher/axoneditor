---
const navItems = [
    { href: "/", label: "Home" },
    { href: "/docs", label: "Docs" },
    { href: "/blog", label: "Blog" },
    { href: "/download", label: "Download" },
    { href: "/releases", label: "Releases" },
];
---

<header
    class="sticky top-0 z-20 border-b border-axon-border bg-axon-bg/95 backdrop-blur"
>
    <div
        class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-3 px-5 py-3"
    >
        <a
            href="/"
            class="flex cursor-pointer items-center gap-3 text-sm font-semibold text-axon-text"
        >
            <img src="/media/icons/axon.png" alt="Axon logo" class="h-8 w-8 rounded-md" />
            <span>Axon</span>
        </a>

        <button
            type="button"
            class="inline-grid h-9 w-9 cursor-pointer place-items-center gap-[0.18rem] rounded-lg border border-white/15 text-axon-text md:hidden [&[aria-expanded=true]>span:nth-child(1)]:translate-y-[0.28rem] [&[aria-expanded=true]>span:nth-child(1)]:rotate-45 [&[aria-expanded=true]>span:nth-child(2)]:opacity-0 [&[aria-expanded=true]>span:nth-child(3)]:-translate-y-[0.28rem] [&[aria-expanded=true]>span:nth-child(3)]:-rotate-45"
            aria-label="Toggle navigation"
            aria-expanded="false"
            data-mobile-nav-toggle
        >
            <span class="block h-px w-4 bg-current transition duration-150"></span>
            <span class="block h-px w-4 bg-current transition duration-150"></span>
            <span class="block h-px w-4 bg-current transition duration-150"></span>
        </button>

        <nav class="order-3 hidden w-full min-w-0 flex-col gap-2 border-t border-white/10 pt-3 md:order-none md:flex md:w-auto md:flex-1 md:flex-row md:items-center md:justify-center md:gap-5 md:border-t-0 md:pt-0" data-mobile-nav>
            {
                navItems.map((item) => (
                    <a
                        href={item.href}
                        class="shrink-0 cursor-pointer rounded-md px-2 py-2 text-sm text-axon-muted transition hover:text-axon-text md:px-0 md:py-0"
                    >
                        {item.label}
                    </a>
                ))
            }
        </nav>

        <div class="flex items-center gap-3">
            <a
                href="/download"
                class="hidden items-center gap-2 rounded-md bg-axon-text px-4 py-2 text-sm font-medium text-axon-bg transition hover:opacity-90 sm:inline-flex"
            >
                Download
            </a>
        </div>
    </div>
</header>

<script type="module">
    if (!window.__axonMobileNavBound) {
        window.__axonMobileNavBound = true;

        document.addEventListener("click", (event) => {
            const target = event.target instanceof Element ? event.target : null;
            const toggle = target?.closest("[data-mobile-nav-toggle]");
            const nav = document.querySelector("[data-mobile-nav]");
            const button = document.querySelector("[data-mobile-nav-toggle]");

            if (!(nav instanceof HTMLElement) || !(button instanceof HTMLButtonElement)) return;

            if (toggle) {
                const isOpen = nav.hasAttribute("data-open");
                nav.toggleAttribute("data-open", !isOpen);
                nav.classList.toggle("hidden", isOpen);
                nav.classList.toggle("flex", !isOpen);
                button.setAttribute("aria-expanded", String(!isOpen));
                return;
            }

            if (target?.closest("[data-mobile-nav] a")) {
                nav.removeAttribute("data-open");
                nav.classList.add("hidden");
                nav.classList.remove("flex");
                button.setAttribute("aria-expanded", "false");
            }
        });

        window.addEventListener("resize", () => {
            if (!window.matchMedia("(min-width: 768px)").matches) return;
            const nav = document.querySelector("[data-mobile-nav]");
            const button = document.querySelector("[data-mobile-nav-toggle]");
            if (!(nav instanceof HTMLElement) || !(button instanceof HTMLButtonElement)) return;
            nav.removeAttribute("data-open");
            nav.classList.add("hidden");
            nav.classList.remove("flex");
            button.setAttribute("aria-expanded", "false");
        });
    }
</script>
