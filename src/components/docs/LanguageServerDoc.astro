---
interface DetailItem {
  title: string;
  body: string;
}

interface Props {
  title: string;
  description: string;
  server: string;
  delivery: string;
  activation: string;
  overview: string[];
  capabilities: string[];
  setup: DetailItem[];
  troubleshooting: DetailItem[];
  packaging: string[];
}

const {
  title,
  description,
  server,
  delivery,
  activation,
  overview,
  capabilities,
  setup,
  troubleshooting,
  packaging,
} = Astro.props;
---

<h1>{title}</h1>

<p>
  {description}
</p>

<div class="my-8 grid gap-3 md:grid-cols-3">
  <div class="rounded-lg border border-axon-border bg-axon-panel p-4 transition duration-200 hover:border-zinc-500">
    <span class="text-[11px] font-semibold uppercase text-axon-muted">Server</span>
    <strong class="mt-2 block text-sm font-medium text-axon-text">{server}</strong>
  </div>
  <div class="rounded-lg border border-axon-border bg-axon-panel p-4 transition duration-200 hover:border-zinc-500">
    <span class="text-[11px] font-semibold uppercase text-axon-muted">Delivery</span>
    <strong class="mt-2 block text-sm font-medium text-axon-text">{delivery}</strong>
  </div>
  <div class="rounded-lg border border-axon-border bg-axon-panel p-4 transition duration-200 hover:border-zinc-500">
    <span class="text-[11px] font-semibold uppercase text-axon-muted">Activation</span>
    <strong class="mt-2 block text-sm font-medium text-axon-text">{activation}</strong>
  </div>
</div>

<h2>What Axon uses it for</h2>
{overview.map((paragraph) => <p>{paragraph}</p>)}

<h2>Expected editor behavior</h2>
<p>
  These are the editor features this server should provide when the workspace
  is opened at the correct root and the project has the runtime or metadata the
  language ecosystem expects.
</p>
<ul>
  {capabilities.map((capability) => <li>{capability}</li>)}
</ul>

<h2>Project setup</h2>
<div class="my-6 grid gap-4 md:grid-cols-2">
  {setup.map((item) => (
    <article class="rounded-lg border border-axon-border bg-axon-panel p-5 transition duration-200 hover:border-zinc-500">
      <h3 class="m-0 text-base font-semibold text-axon-text">{item.title}</h3>
      <p class="mt-2 text-sm leading-6 text-axon-muted">{item.body}</p>
    </article>
  ))}
</div>

<h2>Release packaging</h2>
{packaging.map((paragraph) => <p>{paragraph}</p>)}

<h2>Common failure cases</h2>
<div class="my-6 grid gap-4 md:grid-cols-2">
  {troubleshooting.map((item) => (
    <article class="rounded-lg border border-axon-border bg-axon-panel p-5 transition duration-200 hover:border-zinc-500">
      <h3 class="m-0 text-base font-semibold text-axon-text">{item.title}</h3>
      <p class="mt-2 text-sm leading-6 text-axon-muted">{item.body}</p>
    </article>
  ))}
</div>
