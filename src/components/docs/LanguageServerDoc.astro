---
interface DetailItem {
  title: string;
  body: string;
}

interface Props {
  title: string;
  description: string;
  server: string;
  delivery: string;
  activation: string;
  overview: string[];
  capabilities: string[];
  setup: DetailItem[];
  troubleshooting: DetailItem[];
  packaging: string[];
}

const {
  title,
  description,
  server,
  delivery,
  activation,
  overview,
  capabilities,
  setup,
  troubleshooting,
  packaging,
} = Astro.props;
---

<h1>{title}</h1>

<p>
  {description}
</p>

<div class="my-8 grid gap-3 md:grid-cols-3">
  <div class="rounded-lg border border-white/10 bg-[#0b0b0c] p-4 transition duration-200 hover:border-zinc-500/60 hover:bg-[#141416]">
    <span class="text-[11px] font-semibold uppercase tracking-[0.16em] text-zinc-500">Server</span>
    <strong class="mt-2 block text-sm font-medium text-zinc-100">{server}</strong>
  </div>
  <div class="rounded-lg border border-white/10 bg-[#0b0b0c] p-4 transition duration-200 hover:border-zinc-500/60 hover:bg-[#141416]">
    <span class="text-[11px] font-semibold uppercase tracking-[0.16em] text-zinc-500">Delivery</span>
    <strong class="mt-2 block text-sm font-medium text-zinc-100">{delivery}</strong>
  </div>
  <div class="rounded-lg border border-white/10 bg-[#0b0b0c] p-4 transition duration-200 hover:border-zinc-500/60 hover:bg-[#141416]">
    <span class="text-[11px] font-semibold uppercase tracking-[0.16em] text-zinc-500">Activation</span>
    <strong class="mt-2 block text-sm font-medium text-zinc-100">{activation}</strong>
  </div>
</div>

<h2>What Axon uses it for</h2>
{overview.map((paragraph) => <p>{paragraph}</p>)}

<h2>Expected editor behavior</h2>
<p>
  These are the editor features this server should provide when the workspace
  is opened at the correct root and the project has the runtime or metadata the
  language ecosystem expects.
</p>
<ul>
  {capabilities.map((capability) => <li>{capability}</li>)}
</ul>

<h2>Project setup</h2>
<div class="my-6 grid gap-4 md:grid-cols-2">
  {setup.map((item) => (
    <article class="rounded-lg border border-white/10 bg-[#0b0b0c] p-5 transition duration-200 hover:-translate-y-0.5 hover:border-zinc-500/60 hover:bg-[#141416]">
      <h3 class="m-0 text-base font-semibold text-zinc-100">{item.title}</h3>
      <p class="mt-2 text-sm leading-6 text-zinc-400">{item.body}</p>
    </article>
  ))}
</div>

<h2>Release packaging</h2>
{packaging.map((paragraph) => <p>{paragraph}</p>)}

<h2>Common failure cases</h2>
<div class="my-6 grid gap-4 md:grid-cols-2">
  {troubleshooting.map((item) => (
    <article class="rounded-lg border border-white/10 bg-[#0b0b0c] p-5 transition duration-200 hover:-translate-y-0.5 hover:border-zinc-500/60 hover:bg-[#141416]">
      <h3 class="m-0 text-base font-semibold text-zinc-100">{item.title}</h3>
      <p class="mt-2 text-sm leading-6 text-zinc-400">{item.body}</p>
    </article>
  ))}
</div>
