---
const features = [
  {
    title: "Real workbench",
    description: "Open folders, split panes, drag tabs, edit shared Monaco models, preview Markdown/media, and keep dirty-file prompts predictable.",
  },
  {
    title: "Language intelligence",
    description: "Axon acts as an LSP client for completions, diagnostics, hover, definitions, references, rename, formatting, and code actions.",
  },
  {
    title: "Git, search, terminal",
    description: "Git-aware file colors, gutter markers, diff views, workspace search, and persistent integrated terminal tabs live inside the editor.",
  },
  {
    title: "Themes and extensions",
    description: "Custom themes, imported fonts, bundled Monaspace Nerd Fonts, and declarative local extensions keep customization controlled.",
  },
];
---

<div class="grid gap-4 md:grid-cols-2">
  {features.map((feature, index) => (
    <article class="feature-line reveal-up" style={`animation-delay: ${index * 80}ms`}>
      <p class="text-xs uppercase text-axon-muted">0{index + 1}</p>
      <h3 class="text-lg font-semibold text-zinc-100">{feature.title}</h3>
      <p class="mt-3 text-sm leading-6 text-axon-muted">{feature.description}</p>
    </article>
  ))}
</div>
