---
interface Props {
    title: string;
    href: string;
    class?: string;
}

const { title, href, class: className = "" } = Astro.props;
---

<a
    href={href}
    class:list={[
        "group block cursor-pointer rounded-lg border border-axon-border bg-axon-panel p-5 no-underline transition duration-200 hover:border-zinc-500 hover:bg-axon-panel-soft",
        className,
    ]}
>
    <h3
        class="text-lg font-semibold text-axon-text transition group-hover:text-white"
    >
        {title}
    </h3>
    <div class="mt-2 text-sm leading-6 text-axon-muted">
        <slot />
    </div>
</a>
