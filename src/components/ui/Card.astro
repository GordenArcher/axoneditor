---
interface Props {
    title: string;
    href: string;
    class?: string;
}

const { title, href, class: className = "" } = Astro.props;
---

<a
    href={href}
    class:list={[
        "group block cursor-pointer rounded-lg border border-white/10 bg-[#0b0b0c] p-5 transition duration-200 hover:-translate-y-0.5 hover:border-zinc-500/60 hover:bg-[#141416] hover:shadow-2xl hover:shadow-black/20",
        className,
    ]}
>
    <h3
        class="text-lg font-semibold text-zinc-100 transition group-hover:text-white"
    >
        {title}
    </h3>
    <div class="mt-2 text-sm leading-6 text-zinc-400">
        <slot />
    </div>
</a>
