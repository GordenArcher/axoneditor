---
interface Props {
    variant?: "primary" | "secondary" | "ghost";
    href?: string;
    external?: boolean;
    class?: string;
}

const {
    variant = "primary",
    href,
    external = false,
    class: className = "",
} = Astro.props;

const baseClasses =
    "inline-flex cursor-pointer items-center gap-2 rounded-md px-4 py-2 text-sm font-medium transition focus:outline-none focus:ring-2 focus:ring-axon-cyan focus:ring-offset-2 focus:ring-offset-axon-bg";

const variants = {
    primary:
        "bg-axon-text text-axon-bg hover:opacity-90",
    secondary:
        "border border-axon-border bg-transparent text-axon-text hover:bg-axon-hover",
    ghost: "text-axon-muted hover:bg-axon-hover hover:text-axon-text",
};

const classes = `${baseClasses} ${variants[variant]} ${className}`;
---

{
    href ? (
        <a
            href={href}
            target={external ? "_blank" : undefined}
            rel={external ? "noopener noreferrer" : undefined}
            class={classes}
        >
            <slot />
        </a>
    ) : (
        <button type="button" class={classes}>
            <slot />
        </button>
    )
}
