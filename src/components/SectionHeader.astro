---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="max-w-3xl reveal-up">
  {eyebrow && <p class="mb-3 text-xs font-semibold uppercase text-axon-muted">{eyebrow}</p>}
  <h2 class="text-3xl font-semibold leading-tight text-zinc-100 md:text-4xl">{title}</h2>
  {description && <p class="mt-4 text-base leading-7 text-axon-muted">{description}</p>}
</div>
