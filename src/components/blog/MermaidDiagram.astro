---
interface Props {
  title: string;
  diagram: string;
}

const { title, diagram } = Astro.props;
---

<figure class="overflow-hidden rounded-lg border border-white/10 bg-[#08090a]" data-mermaid-figure>
  <figcaption class="border-b border-white/10 px-4 py-3 text-xs font-medium text-axon-muted">
    {title}
  </figcaption>
  <div class="max-w-full overflow-x-auto p-4 md:p-6">
    <pre class="mermaid w-full text-center" data-mermaid-source>{diagram}</pre>
  </div>
</figure>

<script>
  async function renderPendingDiagrams() {
    const nodes = Array.from(
      document.querySelectorAll<HTMLElement>(".mermaid[data-mermaid-source]:not([data-processed])"),
    );
    if (nodes.length === 0) return;

    try {
      const { default: mermaid } = await import("mermaid");
      mermaid.initialize({
        startOnLoad: false,
        securityLevel: "strict",
        theme: "base",
        fontFamily: "Inter, ui-sans-serif, system-ui, sans-serif",
        themeVariables: {
          background: "#08090a",
          primaryColor: "#141416",
          primaryTextColor: "#f4f4f5",
          primaryBorderColor: "#3f3f46",
          lineColor: "#a1a1aa",
          secondaryColor: "#101012",
          tertiaryColor: "#18181b",
          noteBkgColor: "#18181b",
          noteTextColor: "#e4e4e7",
          noteBorderColor: "#52525b",
          actorBkg: "#141416",
          actorBorder: "#52525b",
          actorTextColor: "#f4f4f5",
          signalColor: "#d4d4d8",
          signalTextColor: "#e4e4e7",
          labelBoxBkgColor: "#141416",
          labelBoxBorderColor: "#52525b",
          labelTextColor: "#f4f4f5",
        },
      });
      await mermaid.run({ nodes });
    } catch (error) {
      console.error("Unable to render architecture diagram.", error);
    }
  }

  void renderPendingDiagrams();
  document.addEventListener("astro:page-load", renderPendingDiagrams);
</script>
