---
import "../styles/global.css";
import Header from "@components/layout/Header.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  publishedAt?: string;
  updatedAt?: string;
  tags?: string[];
}

const {
  title,
  description,
  image = "/media/screenshots/captures/axon-capture-42.png",
  type = "website",
  publishedAt,
  updatedAt,
  tags = [],
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? "https://axoneditor.com").toString();
const imageUrl = new URL(image, Astro.site ?? "https://axoneditor.com").toString();
---

<!doctype html>
<html lang="en" data-theme="dark" data-theme-preference="dark" class="dark">
  <head>
    <script is:inline>
      document.documentElement.dataset.theme = "dark";
      document.documentElement.dataset.themePreference = "dark";
      document.documentElement.classList.add("dark");
    </script>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Axon Editor" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={`${title} cover image`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="canonical" href={canonicalUrl} />
    {publishedAt ? <meta property="article:published_time" content={publishedAt} /> : null}
    {updatedAt ? <meta property="article:modified_time" content={updatedAt} /> : null}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <link rel="icon" type="image/png" href="/media/icons/axon.png" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-axon-bg font-sans text-zinc-300">
    <Header />
    <main>
      <slot />
    </main>
    <footer class="border-t border-white/10 px-5 py-8 text-sm text-axon-muted">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3">
        <p>Axon is a personal AI-powered code editor built seriously for daily work.</p>
        <a href="/releases" class="transition hover:text-zinc-100">Releases</a>
      </div>
    </footer>
  </body>
</html>
