---
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/layout/Header.astro";
import { getSidebarNav } from "@lib/navigation";

interface Props {
    title: string;
    description: string;
}

const { title, description } = Astro.props;
const sidebarNav = getSidebarNav();
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const activeSection =
    sidebarNav.find((section) =>
        section.items.some(
            (item) => (item.href.replace(/\/$/, "") || "/") === currentPath,
        ),
    )?.section ?? "Get started";
const searchEntries = sidebarNav.flatMap((section) =>
    section.items.map((item) => ({
        ...item,
        section: section.section,
    })),
);
---

<BaseLayout title={title} description={description}>
    <Header />

    <div class="grid min-h-[calc(100vh-4.875rem)] bg-axon-bg px-4 pb-5 sm:px-6 lg:grid-cols-[21.5rem_minmax(0,1fr)] lg:px-8">
        <aside class="hidden border-r border-axon-border lg:block">
            <div class="sticky top-[4.875rem] flex h-[calc(100vh-4.875rem)] flex-col overflow-hidden bg-axon-bg py-5 pr-5">
                <button
                    type="button"
                    class="flex h-[3.25rem] w-full items-center gap-3 rounded-lg border border-axon-border bg-axon-bg px-4 text-left text-[16px] text-axon-muted transition hover:border-zinc-500 hover:text-axon-text"
                    aria-haspopup="dialog"
                    data-docs-search-open
                >
                    <span class="text-base leading-none">⌕</span>
                    <span>Search...</span>
                    <span class="ml-auto font-mono text-xs text-zinc-500">⌘K</span>
                </button>

                <nav aria-label="Documentation navigation" class="mt-8 min-h-0 flex-1 overflow-y-auto pr-1">
                    {sidebarNav.map((section) => {
                        const isActiveSection = section.section === activeSection;

                        return (
                            <section class="mb-8 last:mb-0">
                                <h2
                                    class:list={[
                                        "px-3 text-[15px] font-semibold leading-6",
                                        isActiveSection ? "text-axon-text" : "text-axon-muted",
                                    ]}
                                >
                                    {section.section}
                                </h2>
                                <ul class="mt-2 space-y-0.5">
                                    {section.items.map((item) => {
                                        const isActive =
                                            (item.href.replace(/\/$/, "") || "/") === currentPath;

                                        return (
                                            <li>
                                                <a
                                                    href={item.href}
                                                    aria-current={isActive ? "page" : undefined}
                                                    class:list={[
                                                        "relative flex min-h-10 items-center justify-between rounded-lg px-4 py-1.5 text-[15px] leading-6 transition",
                                                        isActive
                                                            ? "bg-axon-panel-soft font-medium text-axon-text"
                                                            : "text-axon-muted hover:bg-axon-panel hover:text-axon-text",
                                                    ]}
                                                >
                                                    <span class="truncate">{item.label}</span>
                                                </a>
                                            </li>
                                        );
                                    })}
                                </ul>
                            </section>
                        );
                    })}
                </nav>
            </div>
        </aside>

        <main class="min-w-0 pt-5">
            <section class="min-h-[calc(100vh-6.125rem)] overflow-hidden rounded-[18px] border border-axon-border bg-black">
                <div class="grid min-h-[calc(100vh-6.125rem)] xl:grid-cols-[minmax(0,1fr)_18rem]">
                    <article
                        class="min-w-0 px-5 py-12 sm:px-8 md:px-12 md:py-16 xl:mx-auto xl:w-full xl:max-w-3xl
                        before:mb-5 before:block before:text-[15px] before:font-medium before:text-axon-muted before:content-[attr(data-section)]
                        [&>h1]:mb-5 [&>h1]:text-[40px] [&>h1]:font-semibold [&>h1]:leading-tight [&>h1]:text-axon-text
                        [&>h2]:mb-3 [&>h2]:mt-14 [&>h2]:scroll-mt-24 [&>h2]:text-[30px] [&>h2]:font-semibold [&>h2]:leading-tight [&>h2]:text-axon-text
                        [&>h3]:mb-2 [&>h3]:mt-7 [&>h3]:scroll-mt-24 [&>h3]:text-base [&>h3]:font-semibold [&>h3]:text-axon-text
                        [&_p]:max-w-3xl [&_p]:text-base [&_p]:leading-7 [&_p]:text-axon-muted
                        [&>p:first-of-type]:text-lg [&>p:first-of-type]:leading-8 [&>p:first-of-type]:text-axon-muted
                        [&_a]:text-axon-text [&_a]:underline [&_a]:decoration-zinc-600 [&_a]:underline-offset-4 [&_a]:transition [&_a:hover]:decoration-zinc-100
                        [&_ul]:my-5 [&_ul]:grid [&_ul]:gap-2 [&_li]:relative [&_li]:pl-5 [&_li]:text-sm [&_li]:leading-7 [&_li]:text-axon-muted
                        [&_li:before]:absolute [&_li:before]:left-0 [&_li:before]:top-[0.72rem] [&_li:before]:h-1.5 [&_li:before]:w-1.5 [&_li:before]:rounded-full [&_li:before]:bg-zinc-600
                        [&_pre]:my-6 [&_pre]:overflow-x-auto [&_pre]:rounded-lg [&_pre]:border [&_pre]:border-axon-border [&_pre]:bg-axon-panel [&_pre]:p-4 [&_pre]:text-sm [&_pre]:leading-6 [&_pre]:text-zinc-200
                        [&_:not(pre)>code]:rounded [&_:not(pre)>code]:border [&_:not(pre)>code]:border-axon-border [&_:not(pre)>code]:bg-axon-panel-soft [&_:not(pre)>code]:px-1.5 [&_:not(pre)>code]:py-0.5 [&_:not(pre)>code]:font-mono [&_:not(pre)>code]:text-[0.88em] [&_:not(pre)>code]:text-zinc-200
                        [&_figure]:my-7 [&_figure]:overflow-hidden [&_figure]:rounded-lg [&_figure]:border [&_figure]:border-axon-border [&_figure]:bg-axon-bg
                        [&_figure_img]:block [&_figure_img]:aspect-video [&_figure_img]:w-full [&_figure_img]:border-b [&_figure_img]:border-axon-border [&_figure_img]:object-cover
                        [&_figcaption]:px-4 [&_figcaption]:py-3 [&_figcaption]:text-sm [&_figcaption]:leading-6 [&_figcaption]:text-axon-muted
                        [&_.grid]:max-w-none"
                        data-section={activeSection}
                        data-docs-content
                    >
                        <slot />
                    </article>

                    <aside class="hidden xl:block" aria-label="On this page" data-docs-toc-shell>
                        <div class="sticky top-24 px-10 py-16">
                            <p class="flex items-center gap-2 text-[16px] font-semibold text-axon-text">
                                <span class="text-zinc-500">≡</span>
                                On this page
                            </p>
                            <nav class="mt-3 grid gap-1 border-l border-axon-border pl-4" data-docs-toc></nav>
                        </div>
                    </aside>
                </div>
            </section>
        </main>
    </div>

    <div
        class="fixed inset-0 z-50 hidden bg-black/70 px-4 py-20 backdrop-blur-sm"
        data-docs-search-modal
    >
        <div
            class="mx-auto max-w-2xl overflow-hidden rounded-lg border border-axon-border bg-axon-bg shadow-2xl shadow-black/70"
            role="dialog"
            aria-modal="true"
            aria-labelledby="docs-search-title"
        >
            <div class="flex items-center gap-3 border-b border-axon-border px-4 py-3">
                <span class="text-lg text-zinc-500">⌕</span>
                <label id="docs-search-title" class="sr-only" for="docs-search-input">
                    Search documentation
                </label>
                <input
                    id="docs-search-input"
                    data-docs-search-input
                    type="search"
                    autocomplete="off"
                    placeholder="Search documentation..."
                    class="min-w-0 flex-1 border-0 bg-transparent py-2 text-base text-axon-text outline-none placeholder:text-zinc-600"
                />
                <button
                    type="button"
                    class="rounded-md border border-axon-border px-2.5 py-1.5 text-xs font-medium text-axon-muted transition hover:border-zinc-500 hover:text-axon-text"
                    data-docs-search-close
                >
                    Esc
                </button>
            </div>
            <div class="max-h-[24rem] overflow-y-auto p-2" data-docs-search-results></div>
        </div>
    </div>

    <script type="module" define:vars={{ searchEntries }}>
        const content = document.querySelector("[data-docs-content]");
        const toc = document.querySelector("[data-docs-toc]");

        if (content instanceof HTMLElement && toc instanceof HTMLElement) {
            const headings = Array.from(content.querySelectorAll("h2, h3")).filter(
                (heading) => heading instanceof HTMLHeadingElement,
            );

            for (const heading of headings) {
                if (!heading.id) {
                    heading.id = heading.textContent
                        .toLowerCase()
                        .replace(/[^a-z0-9]+/g, "-")
                        .replace(/^-|-$/g, "");
                }

                const link = document.createElement("a");
                link.href = `#${heading.id}`;
                link.textContent = heading.textContent || "";
                link.dataset.depth = heading.tagName === "H3" ? "3" : "2";
                link.className =
                    heading.tagName === "H3"
                        ? "block rounded-md py-1 pl-3 pr-2 text-xs leading-5 text-zinc-600 transition hover:text-axon-muted"
                        : "block rounded-md py-1 pl-2 pr-2 text-sm leading-5 text-axon-muted transition hover:text-axon-text";
                toc.append(link);
            }

            if (headings.length === 0) {
                toc.closest("[data-docs-toc-shell]")?.setAttribute("hidden", "");
            }
        }

        const modal = document.querySelector("[data-docs-search-modal]");
        const input = document.querySelector("[data-docs-search-input]");
        const results = document.querySelector("[data-docs-search-results]");
        const openButtons = document.querySelectorAll("[data-docs-search-open]");
        const closeButtons = document.querySelectorAll("[data-docs-search-close]");

        if (
            modal instanceof HTMLElement &&
            input instanceof HTMLInputElement &&
            results instanceof HTMLElement
        ) {
            let lastFocusedElement = null;

            const normalise = (value) => value.trim().toLowerCase();

            const renderResults = () => {
                const query = normalise(input.value);
                const filtered = query
                    ? searchEntries.filter((entry) =>
                          `${entry.label} ${entry.section} ${entry.href}`
                              .toLowerCase()
                              .includes(query),
                      )
                    : searchEntries.slice(0, 8);

                results.replaceChildren();

                if (filtered.length === 0) {
                    const empty = document.createElement("p");
                    empty.className = "px-3 py-10 text-center text-sm text-axon-muted";
                    empty.textContent = "No documentation pages found.";
                    results.append(empty);
                    return;
                }

                for (const entry of filtered.slice(0, 12)) {
                    const link = document.createElement("a");
                    link.href = entry.href;
                    link.className =
                        "block rounded-md px-3 py-3 text-left no-underline transition hover:bg-axon-panel";

                    const label = document.createElement("span");
                    label.className = "block text-sm font-medium text-axon-text";
                    label.textContent = entry.label;

                    const meta = document.createElement("span");
                    meta.className = "mt-1 block text-xs text-axon-muted";
                    meta.textContent = entry.section;

                    link.append(label, meta);
                    results.append(link);
                }
            };

            const openSearch = () => {
                lastFocusedElement =
                    document.activeElement instanceof HTMLElement
                        ? document.activeElement
                        : null;
                modal.classList.remove("hidden");
                document.body.style.overflow = "hidden";
                input.value = "";
                renderResults();
                requestAnimationFrame(() => input.focus());
            };

            const closeSearch = () => {
                modal.classList.add("hidden");
                document.body.style.overflow = "";
                lastFocusedElement?.focus();
            };

            for (const button of openButtons) {
                button.addEventListener("click", openSearch);
            }

            for (const button of closeButtons) {
                button.addEventListener("click", closeSearch);
            }

            input.addEventListener("input", renderResults);

            modal.addEventListener("click", (event) => {
                if (event.target === modal) closeSearch();
            });

            document.addEventListener("keydown", (event) => {
                const usesShortcut =
                    (event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k";
                if (usesShortcut) {
                    event.preventDefault();
                    openSearch();
                    return;
                }

                if (event.key === "Escape" && !modal.classList.contains("hidden")) {
                    closeSearch();
                }
            });
        }
    </script>
</BaseLayout>
