---
import SiteLayout from "@layouts/SiteLayout.astro";

const releaseItems = [
  "Python virtual environment selection in Settings.",
  "Python interpreter detection from the selected virtual environment.",
  "Pyright initialization receives interpreter and venv configuration.",
  "LSP restart action in Settings.",
  "Python built-in fallback completions while Pyright warms up.",
  "Completion requests can auto-start the matching language server.",
  "Language-server logs stream into the Output panel.",
  "Runtime requirement messages for Java, Kotlin, and C#.",
  "Language Server Settings status states for bundled, running, missing, and failed servers.",
];
---

<SiteLayout title="Axon Changelog" description="Release notes and changelog for Axon Editor.">
  <section class="px-5 py-16">
    <div class="mx-auto max-w-5xl">
      <p class="text-xs font-semibold uppercase tracking-[0.24em] text-axon-cyan">Changelog</p>
      <h1 class="mt-4 text-4xl font-semibold text-white md:text-5xl">Release history</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-axon-muted">
        Axon release notes are published with GitHub Releases. This page mirrors
        the current public release while keeping the full assets and notes on GitHub.
      </p>

      <article class="mt-10 rounded-lg border border-white/10 bg-white/[0.035] p-6">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div>
            <h2 class="text-2xl font-semibold text-white">v1.1.3</h2>
            <p class="mt-2 text-sm text-axon-muted">
              Latest shipped desktop release.
            </p>
          </div>
          <a href="https://github.com/GordenArcher/axon/releases/tag/v1.1.3" class="axon-button axon-button-secondary">
            GitHub release
          </a>
        </div>

        <h3 class="mt-8 text-lg font-semibold text-white">Language-server setup improvements</h3>
        <ul class="mt-4 grid gap-3">
          {releaseItems.map((item) => (
            <li class="rounded-lg border border-white/10 bg-black/20 p-4 text-sm leading-6 text-axon-muted">
              {item}
            </li>
          ))}
        </ul>

        <div class="mt-8 rounded-lg border border-axon-cyan/25 bg-axon-cyan/10 p-5">
          <h3 class="text-lg font-semibold text-white">Current honesty note</h3>
          <p class="mt-3 leading-7 text-axon-muted">
            The LSP foundation is present, but each supported language still
            needs small real-project QA before Axon claims every hover, go-to,
            rename, format, and diagnostics path is fully proven.
          </p>
        </div>
      </article>
    </div>
  </section>
</SiteLayout>
