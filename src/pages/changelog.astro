---
import SiteLayout from "@layouts/SiteLayout.astro";
---

<SiteLayout title="Changelog - Axon Editor" description="Release notes and changelog for Axon Editor.">
  <section class="px-5 py-20">
    <div class="mx-auto max-w-4xl">
      <p class="text-xs font-semibold uppercase tracking-[0.24em] text-axon-cyan">Changelog</p>
      <h1 class="mt-4 text-5xl font-semibold text-white">Release history</h1>
      <p class="mt-5 text-lg leading-8 text-axon-muted">
        Current release notes live in the Axon GitHub repository. This page will mirror them once the site starts pulling release data at build time.
      </p>
      <a href="https://github.com/GordenArcher/axon/releases" class="mt-8 inline-flex rounded-full border border-axon-cyan/40 px-5 py-3 text-sm font-semibold text-axon-cyan hover:bg-axon-cyan/10">
        Open releases
      </a>
    </div>
  </section>
</SiteLayout>
