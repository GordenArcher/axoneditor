---
import SiteLayout from "@layouts/SiteLayout.astro";
import { githubReleasesUrl, loadReleases } from "@data/releases";

const releases = await loadReleases();
const latestRelease = releases[0] ?? null;

const releaseFlow = [
  "Version is bumped in the editor package files.",
  "CHANGELOG.md and docs/releases/v<version>.md are updated in the Axon app repo.",
  "A version tag is pushed and GitHub Actions builds platform assets.",
  "The GitHub release is published with notes and marked as the latest release.",
];
---

<SiteLayout title="Axon Changelog" description="How Axon release notes, changelog entries, and platform downloads are published.">
  <section class="px-5 py-16 md:py-20">
    <div class="mx-auto max-w-6xl">
      <p class="text-xs font-semibold uppercase text-axon-muted">Changelog</p>
      <h1 class="mt-4 text-4xl font-semibold leading-tight text-zinc-100 md:text-6xl">
        Release notes live with each shipped version.
      </h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-axon-muted">
        Axon uses GitHub Releases as the source of truth for changelog entries,
        release notes, and platform downloads. The Releases page lists versions;
        each tag page renders the Markdown notes and matching assets.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        {latestRelease && (
          <a href={`/releases/tag/${latestRelease.tag}`} class="axon-button axon-button-primary">
            Latest notes: {latestRelease.tag}
          </a>
        )}
        <a href="/releases" class="axon-button axon-button-secondary">Browse releases</a>
        <a href={githubReleasesUrl} class="axon-button axon-button-secondary">GitHub releases</a>
      </div>
    </div>
  </section>

  <section class="section-line px-5 py-14">
    <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[0.85fr_1.15fr]">
      <div>
        <p class="text-xs font-semibold uppercase text-axon-muted">Update model</p>
        <h2 class="mt-3 text-3xl font-semibold leading-tight text-zinc-100 md:text-4xl">
          Honest release notes, not duplicated lists.
        </h2>
      </div>
      <div class="space-y-5 leading-7 text-axon-muted">
        <p>
          The changelog page explains how releases work. The version-by-version
          list belongs on the Releases page so users do not have two places that
          appear to show the same data.
        </p>
        <p>
          Axon can check GitHub Releases and show release state, but current
          macOS builds are unsigned personal builds. Manual download and
          replacement remains the reliable path until signing, hardened runtime,
          and notarization are in place.
        </p>
      </div>
    </div>
  </section>

  <section class="px-5 py-14">
    <div class="mx-auto max-w-6xl">
      <p class="text-xs font-semibold uppercase text-axon-muted">Release flow</p>
      <h2 class="mt-3 max-w-3xl text-3xl font-semibold leading-tight text-zinc-100 md:text-4xl">
        What changes before a release is published.
      </h2>
      <div class="mt-10 border-y border-white/10">
        {releaseFlow.map((item, index) => (
          <div class="grid gap-4 border-b border-white/10 py-5 last:border-b-0 md:grid-cols-[4rem_1fr]">
            <span class="font-mono text-sm text-axon-muted">0{index + 1}</span>
            <p class="leading-7 text-axon-muted">{item}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</SiteLayout>
