---
import { loadReleases } from "@data/releases";

export async function getStaticPaths() {
  const releases = await loadReleases();
  return releases.map((release) => ({
    params: { slug: release.tag },
    props: { tag: release.tag },
  }));
}

const { tag } = Astro.props;
return Astro.redirect(`/releases/tag/${tag}`, 301);
---
