---
import HomeLayout from "@layouts/HomeLayout.astro";

const roadmap = [
  {
    title: "Finish the extension platform boundary",
    body: "Complete contribution-driven selection and activation for views, icon themes, terminal profiles, languages, agents, tasks, debuggers, and index providers; replace the temporary renderer asset mirror with a real installed-extension asset protocol.",
  },
  {
    title: "Carry multi-root ownership through every project service",
    body: "Problems, search, navigation, Git repositories, terminals, language servers, tests, diagnostics exports, and Axon Agent context must consistently identify the root that owns an action.",
  },
  {
    title: "Deepen language intelligence and refactoring",
    body: "Continue semantic-token coverage, inlay hints, workspace symbols, call hierarchy, imports, refactors, per-language settings, richer code actions, workspace edits across unopened files, and reliable external source navigation.",
  },
  {
    title: "Complete Git review workflows",
    body: "Improve conflict editing, stash safety, cherry-pick and rebase flows, worktree management, side-by-side review ergonomics, and later add first-class pull-request and GitHub review surfaces.",
  },
  {
    title: "Turn Test Explorer into a complete testing loop",
    body: "Expand project-root discovery, focused file and test runs, inline outcomes, failing-location navigation, provider coverage, coverage visualization, and eventually test debugging.",
  },
  {
    title: "Finish the terminal-native Agent experience",
    body: "Move the remaining composer behind explicit interfaces, build the fuller Charmbracelet interaction layer when dependencies align, add a packaged CLI-to-PATH installer, and improve axon fix quality across languages.",
  },
  {
    title: "Strengthen local Agent reliability",
    body: "Add model-specific prompt profiles, deterministic answers for simple workspace facts, stronger tool-call enforcement, clearer context traces, and more reliable project edits without exposing raw runtime details.",
  },
  {
    title: "Make performance and resource use observable",
    body: "Connect Electron-ready, preload, renderer, core, restore, extension, and first-terminal timing; expose renderer memory, Monaco model count, watcher count, language-server processes, Git queues, tests, and local runtime warmup.",
  },
  {
    title: "Continue workbench quality and visual identity",
    body: "Keep splitting oversized editor and CLI responsibilities, polish remaining fixed-color surfaces, tighten tabs and file-tree hierarchy, improve warning and destructive states, and preserve responsiveness across every modal and window size.",
  },
];
---

<HomeLayout title="Roadmap - Axon Editor" description="The planned roadmap for Axon Editor.">
  <section class="px-5 py-16 md:py-20">
    <div class="mx-auto max-w-6xl">
      <p class="text-xs font-semibold uppercase text-[var(--axon-accent)]">Roadmap</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-semibold leading-tight text-zinc-100 md:text-6xl">What comes next</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-axon-muted">
        Axon is in the middle of an architecture migration. New work is being
        shaped around a production IDE structure: workbench surfaces, platform
        services, built-in extensions, extension-facing APIs, and backend
        service boundaries.
      </p>
      <div class="mt-12 grid gap-0">
        {roadmap.map((item, index) => (
          <div class="grid gap-4 border-t border-white/10 py-6 md:grid-cols-[4rem_1fr]">
            <span class="font-mono text-sm text-axon-muted">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h2 class="text-lg font-semibold text-zinc-100">{item.title}</h2>
              <p class="mt-2 max-w-3xl text-sm leading-6 text-axon-muted">{item.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</HomeLayout>
