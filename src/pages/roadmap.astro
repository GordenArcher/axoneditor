---
import SiteLayout from "@layouts/SiteLayout.astro";

const roadmap = [
  "Extension marketplace foundations",
  "Deeper LSP user experience",
  "AI provider service and streaming chat panel",
  "AI patch preview and apply workflow",
  "Git diff context and safer project actions",
];
---

<SiteLayout title="Roadmap - Axon Editor" description="The planned roadmap for Axon Editor.">
  <section class="px-5 py-16 md:py-20">
    <div class="mx-auto max-w-6xl">
      <p class="text-xs font-semibold uppercase text-axon-muted">Roadmap</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-semibold leading-tight text-zinc-100 md:text-6xl">What comes next</h1>
      <div class="mt-12 grid gap-0">
        {roadmap.map((item, index) => (
          <div class="grid gap-4 border-t border-white/10 py-5 md:grid-cols-[4rem_1fr]">
            <span class="font-mono text-sm text-axon-muted">0{index + 1}</span>
            <span class="text-zinc-100">{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>
</SiteLayout>
