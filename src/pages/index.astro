---
import PlatformDownload from "@components/home/DownloadCard.astro";
import LandingShowcase from "@components/motion/LandingShowcase";
import HomeLayout from "@layouts/HomeLayout.astro";
import { loadReleases } from "@data/releases";

const releases = await loadReleases();
const latestRelease = releases[0] ?? null;

const flow = [
  {
    number: "01",
    title: "Open the project",
    body: "Restore the workspace, tabs, and project services without waiting for the interface to catch up.",
  },
  {
    number: "02",
    title: "Read the whole system",
    body: "Language servers, Problems, search, and Git stay aligned with the folder you are actually working in.",
  },
  {
    number: "03",
    title: "Change with confidence",
    body: "Edit across panes, run tests, keep terminals alive, and review diffs without breaking your train of thought.",
  },
  {
    number: "04",
    title: "Ship from one place",
    body: "Move from the first edit to the final Git review with the same project context intact.",
  },
];
---

<HomeLayout
  title="Axon Editor — Your project, fully in view"
  description="Axon is a local-first code editor where language tooling, Git, tests, terminals, and your AI agent work from the same project context."
  image="/media/screenshots/captures/axon-capture-61.png"
>
  <LandingShowcase client:load />

  <section class="px-5 py-20 sm:py-28">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-8 lg:grid-cols-[0.72fr_1.28fr] lg:items-end">
        <div>
          <p class="section-kicker">Everything agrees</p>
          <h2 class="mt-4 max-w-3xl text-balance text-4xl font-semibold leading-[1.02] tracking-[-0.045em] text-zinc-100 sm:text-6xl">
            One workspace.<br />No context tax.
          </h2>
        </div>
        <p class="max-w-2xl text-pretty text-lg leading-8 text-zinc-400 lg:justify-self-end">
          Axon connects the surfaces you already use so the editor, terminal,
          source control, tests, and agent stop rebuilding the same understanding
          of your project in isolation.
        </p>
      </div>

      <div class="mt-14 grid gap-4 lg:grid-cols-12">
        <article class="feature-panel group relative overflow-hidden lg:col-span-7 lg:row-span-2">
          <div class="relative z-10 max-w-lg p-6 sm:p-8">
            <span class="feature-index">01 / Editor</span>
            <h3 class="mt-5 text-2xl font-semibold tracking-tight text-zinc-100 sm:text-3xl">Code stays at the center.</h3>
            <p class="mt-3 max-w-md text-sm leading-6 text-zinc-400 sm:text-base sm:leading-7">
              Monaco editing, split panes, syntax depth, file previews, and live
              formatting controls behave like one coherent editing system.
            </p>
          </div>
          <div class="relative ml-6 mt-3 overflow-hidden rounded-tl-xl border-l border-t border-white/10 sm:ml-12">
            <img
              src="/media/screenshots/captures/axon-capture-42.png"
              alt="Axon split editor showing TypeScript and Go code side by side"
              loading="lazy"
              class="block w-full opacity-80 transition duration-700 group-hover:scale-[1.015] group-hover:opacity-100"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0b0b0a] via-transparent to-transparent"></div>
          </div>
        </article>

        <article class="feature-panel group min-h-[22rem] lg:col-span-5">
          <div class="p-6 sm:p-8">
            <span class="feature-index">02 / Project intelligence</span>
            <h3 class="mt-5 text-2xl font-semibold tracking-tight text-zinc-100">Signals, not noise.</h3>
            <p class="mt-3 text-sm leading-6 text-zinc-400">
              Diagnostics, language servers, and workspace-aware tests point to
              the project that is open—not a guessed root.
            </p>
          </div>
          <div class="mx-6 mb-6 overflow-hidden rounded-xl border border-white/[0.08] bg-black sm:mx-8">
            <div class="flex items-center gap-2 border-b border-white/[0.07] px-4 py-3 font-mono text-[10px] text-zinc-600">
              <span class="h-1.5 w-1.5 rounded-full bg-[#9dcc82]"></span>
              project services / ready
            </div>
            <div class="space-y-3 p-4 font-mono text-xs">
              <p class="flex items-center justify-between"><span class="text-zinc-400">typescript.lsp</span><span class="text-[#9dcc82]">warm</span></p>
              <p class="flex items-center justify-between"><span class="text-zinc-400">workspace.tests</span><span class="text-[#9dcc82]">12 passing</span></p>
              <p class="flex items-center justify-between"><span class="text-zinc-400">git.watcher</span><span class="text-[#9dcc82]">synced</span></p>
            </div>
          </div>
        </article>

        <article class="feature-panel group min-h-[22rem] lg:col-span-5">
          <div class="p-6 sm:p-8">
            <span class="feature-index">03 / Axon Agent</span>
            <h3 class="mt-5 text-2xl font-semibold tracking-tight text-zinc-100">Help that knows where it is.</h3>
            <p class="mt-3 text-sm leading-6 text-zinc-400">
              The agent can attach to real files, terminal sessions, Problems,
              language tooling, and Git state instead of starting from an empty chat.
            </p>
          </div>
          <div class="mx-6 mb-6 rounded-xl border border-white/[0.08] bg-black/50 p-4 sm:mx-8">
            <p class="font-mono text-[10px] uppercase tracking-wider text-[#d5a45f]">axon agent</p>
            <p class="mt-3 text-sm leading-6 text-zinc-400">I found the failing test and its call site. Keep both open?</p>
            <div class="mt-4 flex gap-2 text-[11px]">
              <span class="rounded-md bg-[#d5a45f] px-2.5 py-1.5 font-medium text-black">Open split</span>
              <span class="rounded-md border border-white/10 px-2.5 py-1.5 text-zinc-500">Show diff</span>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="border-y border-white/[0.07] bg-white/[0.012] px-5 py-20 sm:py-28">
    <div class="mx-auto max-w-7xl">
      <div class="max-w-3xl">
        <p class="section-kicker">The daily loop</p>
        <h2 class="mt-4 text-balance text-4xl font-semibold leading-[1.04] tracking-[-0.045em] text-zinc-100 sm:text-6xl">
          Momentum from open to ship.
        </h2>
      </div>

      <div class="mt-14 grid border-t border-white/10 md:grid-cols-2 lg:grid-cols-4">
        {flow.map((item) => (
          <article class="flow-step border-b border-white/10 py-7 md:px-6 md:first:pl-0 lg:border-b-0 lg:border-r lg:last:border-r-0">
            <span class="font-mono text-xs text-[#b68a52]">{item.number}</span>
            <h3 class="mt-8 text-xl font-semibold text-zinc-100">{item.title}</h3>
            <p class="mt-3 text-sm leading-6 text-zinc-500">{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="px-5 py-20 sm:py-28">
    <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[0.82fr_1.18fr] lg:items-center">
      <div>
        <p class="section-kicker">Built for the desktop</p>
        <h2 class="mt-4 text-balance text-4xl font-semibold leading-[1.04] tracking-[-0.045em] text-zinc-100 sm:text-6xl">
          Local at the core.<br />Open by design.
        </h2>
        <p class="mt-6 max-w-xl text-lg leading-8 text-zinc-400">
          A Go core owns workspace services, file watching, terminals, Git, and
          testing outside the renderer. The extension path keeps the workbench
          adaptable without turning the editor into a browser tab.
        </p>
        <a href="/features" class="group mt-8 inline-flex items-center gap-2 text-sm font-semibold text-[#ddb06c] transition hover:text-[#f1c37e]">
          Explore the architecture
          <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
        </a>
      </div>

      <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-[#0a0a09] p-3 shadow-2xl shadow-black/30 sm:p-5">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_80%_10%,rgba(201,154,91,0.12),transparent_45%)]"></div>
        <div class="relative grid gap-3 sm:grid-cols-2">
          <article class="foundation-card sm:col-span-2">
            <span class="foundation-pip bg-[#d5a45f]"></span>
            <div><h3>Go workspace core</h3><p>File services, PTYs, Git, tests, and backend APIs.</p></div>
          </article>
          <article class="foundation-card">
            <span class="foundation-pip bg-[#73b7d6]"></span>
            <div><h3>Language aware</h3><p>LSP, TextMate scopes, and semantic tokens.</p></div>
          </article>
          <article class="foundation-card">
            <span class="foundation-pip bg-[#9dcc82]"></span>
            <div><h3>Extension ready</h3><p>Contribution points, manifests, and activation events.</p></div>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="px-5 pb-20 sm:pb-28">
    <div class="relative mx-auto max-w-7xl overflow-hidden rounded-2xl border border-[#c99a5b]/20 bg-[#100e0b] px-6 py-10 sm:px-10 sm:py-12">
      <div class="pointer-events-none absolute -right-24 -top-32 h-80 w-80 rounded-full bg-[#c99a5b]/10 blur-3xl"></div>
      <div class="relative grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
        <div>
          <p class="section-kicker">Start where the work is</p>
          <h2 class="mt-4 max-w-2xl text-balance text-3xl font-semibold tracking-[-0.035em] text-zinc-100 sm:text-5xl">
            Bring the whole project into focus.
          </h2>
          <p class="mt-4 max-w-xl text-sm leading-6 text-zinc-400 sm:text-base">
            Download the latest desktop build for macOS, Windows, or Linux.
          </p>
        </div>
        <PlatformDownload assets={latestRelease?.assets ?? []} releaseTag={latestRelease?.tag} />
      </div>
    </div>
  </section>
</HomeLayout>
