---
import PlatformDownload from "@components/home/DownloadCard.astro";
import LandingShowcase from "@components/motion/LandingShowcase";
import WritingLoop from "@components/motion/WritingLoop";
import HomeLayout from "@layouts/HomeLayout.astro";
import { loadReleases } from "@data/releases";

const releases = await loadReleases();
const latestRelease = releases[0] ?? null;

const workbenchCards = [
  {
    label: "Editor",
    title: "Rich code, real project state",
    body: "Axon treats Monaco, syntax tokens, file models, live indentation controls, code snapshots, previews, and split panes as one editor system.",
  },
  {
    label: "Source control",
    title: "Git flows beside the code",
    body: "Status, diffs, graph, history, conflicts, and workspace file colors are shaped as workbench surfaces instead of disconnected commands.",
  },
  {
    label: "Testing",
    title: "Project-aware test runs",
    body: "Test discovery follows the selected workspace and avoids generated folders so the output feels like the project you opened.",
  },
  {
    label: "Agent",
    title: "Local context before chat",
    body: "Axon Agent sits on top of files, terminals, Problems, LSP, and Git so assistance can attach to actual editor facts.",
  },
];

const foundations = [
  ["Go core", "Workspace services, file watching, PTY sessions, Git, tests, and backend APIs live outside the renderer."],
  ["Extension path", "Themes, icons, search, settings, terminal, source control, testing, and Problems are moving behind contribution points."],
  ["Syntax pipeline", "A custom coloring layer fills Monaco gaps with TextMate scopes, LSP semantic tokens, Axon-owned decorations, and theme-aware snapshot exports."],
];

const dailyFlow = [
  ["01", "Open", "Axon opens the workspace, restores tabs, warms file services, and keeps the UI responsive while project systems start."],
  ["02", "Understand", "Language servers discover nested and cross-directory projects while syntax scopes, Problems, Git state, and search stay aligned with the workspace."],
  ["03", "Change", "Split panes, terminal sessions, tests, file watching, previews, and source control stay close to the code being edited."],
  ["04", "Ship", "Release notes, downloads, diagnostics, and extension contributions are becoming part of the same production-grade workflow."],
];

const proofPoints = [
  ["Code snapshots", "Theme-aware PNG exports include syntax color, line controls, and Axon branding."],
  ["Editor formatting", "Tab width, spaces, guide visibility, active scopes, and code spacing update live."],
  ["Project tests", "Workspace-aware discovery avoids generated folders and wrong roots."],
  ["Git watcher", "File and folder status updates are tied to active workspace state."],
  ["Extension registry", "Built-in themes/icons and future installs move through manifests."],
  ["Release pipeline", "CI, package builds, release notes, and diagnostics are being hardened."],
];
---

<HomeLayout
  title="Axon Editor - Personal AI-powered code editor"
  description="Axon is a local-first desktop code editor with a Go backend, bundled language tooling, Git workflows, terminal sessions, tests, Problems, extensions, and Axon Agent."
>
  <LandingShowcase client:load />

  <section class="px-5 pb-10">
    <div class="mx-auto max-w-7xl rounded-2xl border border-white/10 bg-white/[0.025] p-4 md:p-5">
      <div class="grid gap-5 md:grid-cols-[minmax(0,1fr)_auto] md:items-center">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-axon-muted">Latest build</p>
          <h2 class="mt-2 text-2xl font-semibold text-zinc-100">Download the current desktop release.</h2>
          <p class="mt-2 max-w-2xl text-sm leading-6 text-axon-muted">
            Platform detection picks the likely build first, while every release
            asset stays available for Mac Intel, Apple Silicon, Windows, and Linux.
          </p>
        </div>
        <PlatformDownload
          assets={latestRelease?.assets ?? []}
          releaseTag={latestRelease?.tag}
        />
      </div>
    </div>
  </section>

  <section class="px-5 py-16">
    <div class="mx-auto max-w-7xl">
      <div class="mb-10 max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-axon-muted">Daily flow</p>
        <h2 class="mt-3 text-3xl font-semibold leading-tight text-zinc-100 md:text-5xl">
          Axon is designed around the way real coding sessions unfold.
        </h2>
      </div>

      <div class="grid gap-4 lg:grid-cols-4">
        {dailyFlow.map(([step, title, body]) => (
          <article class="group rounded-2xl border border-white/10 bg-white/[0.025] p-5 transition hover:-translate-y-1 hover:border-white/25 hover:bg-white/[0.045]">
            <div class="mb-8 flex items-center justify-between">
              <span class="font-mono text-xs text-axon-muted">{step}</span>
              <span class="h-2 w-2 rounded-full bg-[#59c2ff] opacity-50 transition group-hover:opacity-100"></span>
            </div>
            <h3 class="text-2xl font-semibold text-zinc-100">{title}</h3>
            <p class="mt-4 text-sm leading-6 text-axon-muted">{body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <WritingLoop client:load />

  <section class="border-y border-white/10 px-5 py-16">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-8 lg:grid-cols-[0.42fr_0.58fr]">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-axon-muted">Workbench</p>
          <h2 class="mt-3 text-3xl font-semibold leading-tight text-zinc-100 md:text-5xl">
            One project, many surfaces, same facts.
          </h2>
          <p class="mt-5 text-lg leading-8 text-axon-muted">
            The point of Axon is not another sidebar. The point is a desktop
            editor where the important systems agree on the workspace they are
            serving.
          </p>
        </div>

        <div class="grid gap-4 md:grid-cols-2">
          {workbenchCards.map((card) => (
            <article class="rounded-2xl border border-white/10 bg-white/[0.025] p-5 transition hover:-translate-y-1 hover:border-white/25 hover:bg-white/[0.045]">
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-axon-muted">{card.label}</p>
              <h3 class="mt-4 text-xl font-semibold leading-tight text-zinc-100">{card.title}</h3>
              <p class="mt-3 text-sm leading-6 text-axon-muted">{card.body}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="px-5 py-16">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-8 lg:grid-cols-[0.42fr_0.58fr] lg:items-start">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-axon-muted">Foundations</p>
          <h2 class="mt-3 text-3xl font-semibold leading-tight text-zinc-100 md:text-5xl">
            Built like an editor, not a web app pretending.
          </h2>
        </div>
        <div>
          <div class="mt-8 grid gap-4">
            {foundations.map(([title, body]) => (
              <article class="border-t border-white/10 pt-4">
                <h3 class="text-lg font-semibold text-zinc-100">{title}</h3>
                <p class="mt-2 text-sm leading-6 text-axon-muted">{body}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="px-5 py-16">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-8 lg:grid-cols-[0.38fr_0.62fr]">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-axon-muted">Proof of work</p>
          <h2 class="mt-3 text-3xl font-semibold leading-tight text-zinc-100 md:text-5xl">
            The roadmap is already visible in the product.
          </h2>
          <p class="mt-5 text-lg leading-8 text-axon-muted">
            Axon is still moving fast, but the big pieces are no longer just
            ideas. They are being wired into the editor, release process, and
            extension architecture.
          </p>
        </div>
        <div class="grid gap-3 md:grid-cols-2">
          {proofPoints.map(([title, body]) => (
            <article class="rounded-2xl border border-white/10 bg-white/[0.025] p-5">
              <h3 class="text-lg font-semibold text-zinc-100">{title}</h3>
              <p class="mt-2 text-sm leading-6 text-axon-muted">{body}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

</HomeLayout>
