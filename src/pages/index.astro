---
import FeatureGrid from "@components/FeatureGrid.astro";
import SectionHeader from "@components/SectionHeader.astro";
import SiteLayout from "@layouts/SiteLayout.astro";

const downloadArtifacts = [
  "macOS Apple Silicon",
  "macOS Intel",
  "Windows",
  "Linux AppImage",
  "Debian / Ubuntu",
];

const workflowHighlights = [
  {
    title: "Language servers that ship with the app",
    body: "Release builds include managed language-server bundles for supported platforms, with runtime notes where Java, Kotlin, C#, and similar ecosystems still need local tools.",
  },
  {
    title: "Editor foundations before AI shortcuts",
    body: "Axon already has workspace context, Git state, diagnostics, terminal sessions, previews, settings, and command flows that future AI features can use without feeling bolted on.",
  },
  {
    title: "Personal-use, honest distribution",
    body: "The current macOS builds are unsigned personal builds, so the site points users to reliable manual downloads instead of promising automatic replacement that Gatekeeper may block.",
  },
];
---

<SiteLayout
  title="Axon Editor - Personal AI-powered code editor"
  description="Axon is a personal AI-powered desktop code editor with files, panes, terminal, Git, search, previews, settings, themes, extensions, and language-server support."
>
  <section class="px-5 pb-12 pt-12 md:pb-16 md:pt-16">
    <div class="mx-auto grid max-w-6xl items-center gap-8 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <div class="mb-5 flex items-center gap-3">
          <img src="/axon.png" alt="" class="h-12 w-12 rounded-xl" />
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-axon-cyan">
            Axon Editor
          </p>
        </div>
        <h1 class="max-w-2xl text-4xl font-semibold leading-tight text-white md:text-6xl">
          A serious personal code editor for day-to-day work.
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-8 text-axon-muted">
          Axon is a desktop editor with real foundations already in place:
          workspace files, split panes, Git, terminal tabs, search, previews,
          themes, fonts, settings, extensions, and language-server support.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/download" class="axon-button axon-button-primary">
            Download Axon
          </a>
          <a href="/docs/extensions" class="axon-button axon-button-secondary">
            Extension docs
          </a>
        </div>
        <p class="mt-5 text-sm leading-6 text-axon-muted">
          Latest shipped desktop release: <span class="font-semibold text-white">v1.1.3</span>.
        </p>
      </div>
      <div class="axon-frame overflow-hidden">
        <img
          src="/media/axon-demo.gif"
          alt="Axon editor showing the workspace, file tree, code editor, and terminal"
          class="block w-full"
        />
      </div>
    </div>
  </section>

  <section class="border-y border-white/10 bg-white/[0.025] px-5 py-14">
    <div class="mx-auto max-w-6xl">
      <SectionHeader
        eyebrow="Workbench"
        title="The product is the editor"
        description="This site leads with the actual Axon workspace because the app is already more than a Monaco demo shell."
      />
      <div class="mt-10">
        <FeatureGrid />
      </div>
    </div>
  </section>

  <section class="px-5 py-14">
    <div class="mx-auto grid max-w-6xl gap-8 lg:grid-cols-[0.85fr_1.15fr]">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-axon-cyan">
          Downloads
        </p>
        <h2 class="mt-3 text-3xl font-semibold text-white md:text-4xl">
          Release artifacts for each desktop platform.
        </h2>
        <p class="mt-4 leading-7 text-axon-muted">
          Axon publishes platform-specific builds on GitHub Releases. macOS
          builds are unsigned right now, so manual download and replacement is
          the reliable path until signing and notarization are in place.
        </p>
        <a href="/download" class="axon-button axon-button-secondary mt-6">
          View download guide
        </a>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        {downloadArtifacts.map((artifact) => (
          <div class="rounded-lg border border-white/10 bg-white/[0.035] p-4 text-sm font-semibold text-white">
            {artifact}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-white/10 bg-white/[0.025] px-5 py-14">
    <div class="mx-auto max-w-6xl">
      <SectionHeader
        eyebrow="Language intelligence"
        title="LSP client foundations, with honest runtime notes"
        description="Axon uses language servers instead of reimplementing each language. Some servers are bundled, while some ecosystems still need local runtimes."
      />
      <div class="mt-10 grid gap-4 md:grid-cols-3">
        {workflowHighlights.map((item) => (
          <article class="rounded-lg border border-white/10 bg-[#10151b] p-5">
            <h3 class="text-lg font-semibold text-white">{item.title}</h3>
            <p class="mt-3 text-sm leading-6 text-axon-muted">{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="px-5 py-14">
    <div class="mx-auto max-w-6xl">
      <SectionHeader
        eyebrow="Screenshots"
        title="The current Axon desktop build"
        description="Screenshots and demo media are copied from the Axon project docs so the site shows the real product state."
      />
      <div class="mt-10 grid gap-5">
        {[1, 2, 3, 4, 5].map((item) => (
          <img
            src={`/media/axon-screenshot-0${item}.png`}
            alt={`Axon editor screenshot ${item}`}
            class="axon-frame w-full"
          />
        ))}
      </div>
    </div>
  </section>

  <section class="px-5 pb-16">
    <div class="mx-auto grid max-w-6xl items-center gap-6 rounded-lg border border-white/10 bg-white/[0.035] p-6 md:grid-cols-[1fr_auto]">
      <div>
        <h2 class="text-2xl font-semibold text-white">Full demo recording</h2>
        <p class="mt-2 leading-7 text-axon-muted">
          The full recording shows Axon running against its own repository.
        </p>
      </div>
      <a href="/media/axon-demo-full.mp4" class="axon-button axon-button-primary">
        Open video
      </a>
    </div>
  </section>
</SiteLayout>
