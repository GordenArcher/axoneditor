---
import HomeLayout from "@layouts/HomeLayout.astro";
import { blogPosts } from "@data/blog";
---

<HomeLayout
  title="Axon Blog"
  description="Engineering notes, release stories, and debugging writeups from Axon Editor."
>
  <section class="px-5 py-12">
    <div class="mx-auto max-w-6xl">
      <p class="text-xs font-semibold uppercase text-axon-muted">Blog</p>
      <h1 class="mt-4 max-w-4xl text-4xl font-semibold leading-tight text-zinc-100 md:text-5xl">
        Notes from building Axon in public.
      </h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-axon-muted">
        Long-form engineering stories from the editor: the bugs, the fixes,
        the release loops, and the small details that make Axon feel like a
        real tool instead of a demo.
      </p>
    </div>
  </section>

  <section class="px-5 pb-20 pt-8">
    <div class="mx-auto grid max-w-6xl gap-0 border-y border-white/10">
      {blogPosts.map((post) => (
        <article class="grid gap-6 border-b border-white/10 py-8 last:border-b-0 md:grid-cols-[minmax(0,1fr)_auto] md:items-start">
          <div>
            <div class="flex flex-wrap items-center gap-2 text-xs uppercase text-axon-muted">
              <span>{post.publishedAt}</span>
              <span>•</span>
              <span>{post.readingTime}</span>
            </div>
            <h2 class="mt-3 text-2xl font-semibold text-zinc-100 md:text-3xl">
              <a href={`/blog/${post.slug}`} class="transition hover:text-white">
                {post.title}
              </a>
            </h2>
            <p class="mt-4 max-w-3xl leading-7 text-axon-muted">{post.excerpt}</p>
            <div class="mt-5 flex flex-wrap items-center gap-3">
              {post.authors.map((author) => (
                <a href={author.github} class="inline-flex items-center gap-2 rounded-full border border-white/10 px-3 py-1.5 text-xs font-medium text-axon-muted transition hover:border-white/25 hover:text-zinc-100" target="_blank" rel="noreferrer">
                  <img src={author.avatar} alt="" class="h-5 w-5 rounded-full" />
                  <span>{author.name}</span>
                </a>
              ))}
            </div>
          </div>
          <a href={`/blog/${post.slug}`} class="inline-flex items-center rounded-md border border-white/10 px-3 py-2 text-sm font-semibold text-zinc-100 transition hover:bg-white/10">Read</a>
        </article>
      ))}
    </div>
  </section>
</HomeLayout>
