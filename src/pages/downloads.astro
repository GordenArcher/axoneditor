---
import SiteLayout from "@layouts/SiteLayout.astro";

const downloads = [
  ["macOS Apple Silicon", "Axon-<version>-arm64.dmg"],
  ["macOS Intel", "Axon-<version>.dmg"],
  ["Windows", "Axon.Setup.<version>.exe"],
  ["Linux AppImage", "Axon-<version>.AppImage"],
  ["Debian / Ubuntu", "axon_<version>_amd64.deb"],
];
---

<SiteLayout title="Downloads - Axon Editor" description="Download Axon for macOS, Windows, and Linux.">
  <section class="px-5 py-20">
    <div class="mx-auto max-w-4xl">
      <p class="text-xs font-semibold uppercase tracking-[0.24em] text-axon-cyan">Downloads</p>
      <h1 class="mt-4 text-5xl font-semibold text-white">Choose your build</h1>
      <p class="mt-5 text-lg leading-8 text-axon-muted">
        Axon releases are published on GitHub. Pick the artifact that matches your platform and CPU.
      </p>
      <div class="mt-10 overflow-hidden rounded-2xl border border-white/10">
        {downloads.map(([platform, file]) => (
          <div class="grid gap-2 border-b border-white/10 bg-white/[0.025] p-5 last:border-b-0 md:grid-cols-[0.6fr_1fr]">
            <span class="font-medium text-white">{platform}</span>
            <code class="text-sm text-axon-cyan">{file}</code>
          </div>
        ))}
      </div>
      <a href="https://github.com/GordenArcher/axon/releases" class="mt-8 inline-flex rounded-full bg-axon-cyan px-5 py-3 text-sm font-semibold text-[#071017]">
        View GitHub releases
      </a>
    </div>
  </section>
</SiteLayout>
