---
import HomeLayout from "@layouts/HomeLayout.astro";
import { githubReleasesUrl, loadReleases } from "@data/releases";

const releases = await loadReleases();
const latestRelease = releases[0] ?? null;
---

<HomeLayout title="Download Axon Editor" description="Download Axon Editor release builds for macOS, Windows, and Linux.">
  <section class="px-5 py-16 md:py-20">
    <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[0.85fr_1.15fr]">
      <div class="animate-[reveal-up_720ms_cubic-bezier(0.16,1,0.3,1)_both]">
        <p class="text-xs font-semibold uppercase text-[var(--axon-accent)]">Download</p>
        <h1 class="mt-4 text-4xl font-semibold leading-tight text-zinc-100 md:text-6xl">
          Get the Axon build for your machine.
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-axon-muted">
          The primary button detects the visitor's platform in the browser.
          The full asset list stays visible so Mac Intel, Mac Apple Silicon,
          Windows, and Linux users can choose directly.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          {latestRelease && (
            <a href={`/releases/tag/${latestRelease.tag}`} class="inline-flex items-center gap-2 rounded-md border border-axon-border bg-transparent px-4 py-2 text-sm font-medium text-axon-text transition hover:bg-axon-hover">
              Release notes
            </a>
          )}
          <a href="/releases" class="inline-flex items-center gap-2 rounded-md border border-axon-border bg-transparent px-4 py-2 text-sm font-medium text-axon-text transition hover:bg-axon-hover">
            All releases
          </a>
          <a href={githubReleasesUrl} class="inline-flex items-center gap-2 rounded-md border border-axon-border bg-transparent px-4 py-2 text-sm font-medium text-axon-text transition hover:bg-axon-hover">
            GitHub
          </a>
        </div>
      </div>

      <div class="animate-[reveal-up_720ms_cubic-bezier(0.16,1,0.3,1)_both] [animation-delay:120ms]">
        <div class="grid border-y border-white/10">
          {latestRelease?.assets.length ? (
            latestRelease.assets.map((asset) => (
              <a href={asset.downloadUrl} class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-4 border-b border-white/10 py-4 transition hover:text-[var(--axon-accent)] last:border-b-0">
                <span>
                  <span class="block text-sm font-semibold text-zinc-100">{asset.platform}</span>
                  <span class="mt-1 block break-all text-xs text-axon-muted">{asset.name}</span>
                </span>
                <span class="text-xs text-axon-muted">
                  {asset.size > 0 ? `${(asset.size / 1024 / 1024).toFixed(1)} MB` : "Download"}
                </span>
              </a>
            ))
          ) : (
            <div class="py-5 text-sm text-axon-muted">
              Release assets unavailable. Open the GitHub releases page for downloads.
            </div>
          )}
        </div>
        {latestRelease && (
          <p class="mt-3 text-xs text-axon-muted">
            Latest release: <span class="font-semibold text-zinc-100">{latestRelease.tag}</span>
          </p>
        )}
      </div>
    </div>
  </section>

  <section class="border-y border-white/10 px-5 py-14">
    <div class="mx-auto grid max-w-6xl gap-8 md:grid-cols-3">
      <div class="border-t border-white/10 pt-5">
        <p class="text-xs uppercase text-axon-muted">macOS</p>
        <h2 class="mt-3 text-xl font-semibold text-zinc-100">Apple Silicon and Intel</h2>
        <p class="mt-3 text-sm leading-6 text-axon-muted">
          Use the Apple Silicon build for M-series Macs and the Intel build for
          older x86 Macs. Current macOS builds are unsigned personal builds.
        </p>
      </div>
      <div class="border-t border-white/10 pt-5">
        <p class="text-xs uppercase text-axon-muted">Windows</p>
        <h2 class="mt-3 text-xl font-semibold text-zinc-100">Installer asset</h2>
        <p class="mt-3 text-sm leading-6 text-axon-muted">
          Windows visitors are pointed at the Windows release artifact when the
          browser platform can be detected.
        </p>
      </div>
      <div class="border-t border-white/10 pt-5">
        <p class="text-xs uppercase text-axon-muted">Linux</p>
        <h2 class="mt-3 text-xl font-semibold text-zinc-100">AppImage and packages</h2>
        <p class="mt-3 text-sm leading-6 text-axon-muted">
          Linux assets remain listed by package type so users can choose the
          build that fits their distribution.
        </p>
      </div>
    </div>
  </section>
</HomeLayout>
