---
import SiteLayout from "@layouts/SiteLayout.astro";

const downloads = [
  ["macOS Apple Silicon", "Axon-1.1.3-arm64.dmg", "Use this for M-series Macs."],
  ["macOS Intel", "Axon-1.1.3.dmg", "Use this for Intel Macs."],
  ["Windows", "Axon.Setup.1.1.3.exe", "Installer build for Windows desktops."],
  ["Linux AppImage", "Axon-1.1.3.AppImage", "Portable Linux desktop build."],
  ["Debian / Ubuntu", "axon_1.1.3_amd64.deb", "Package build for Debian-based systems."],
];
---

<SiteLayout title="Download Axon Editor" description="Download Axon Editor release builds for macOS, Windows, and Linux.">
  <section class="px-5 py-16">
    <div class="mx-auto max-w-5xl">
      <p class="text-xs font-semibold uppercase tracking-[0.24em] text-axon-cyan">Download</p>
      <h1 class="mt-4 text-4xl font-semibold text-white md:text-5xl">Choose the matching Axon build</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-axon-muted">
        The latest shipped release is <span class="font-semibold text-white">v1.1.3</span>.
        Release assets are published on GitHub for macOS, Windows, and Linux.
      </p>

      <div class="mt-10 overflow-hidden rounded-lg border border-white/10">
        {downloads.map(([platform, file, note]) => (
          <div class="grid gap-2 border-b border-white/10 bg-white/[0.025] p-5 last:border-b-0 md:grid-cols-[0.45fr_0.55fr_1fr]">
            <span class="font-semibold text-white">{platform}</span>
            <code class="text-sm text-axon-cyan">{file}</code>
            <span class="text-sm leading-6 text-axon-muted">{note}</span>
          </div>
        ))}
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="https://github.com/GordenArcher/axon/releases/tag/v1.1.3" class="axon-button axon-button-primary">
          Open v1.1.3 release
        </a>
        <a href="https://github.com/GordenArcher/axon/releases" class="axon-button axon-button-secondary">
          All GitHub releases
        </a>
      </div>

      <div class="mt-10 rounded-lg border border-axon-amber/30 bg-axon-amber/10 p-5">
        <h2 class="text-lg font-semibold text-white">macOS signing note</h2>
        <p class="mt-3 leading-7 text-axon-muted">
          Current macOS builds are unsigned personal builds. Gatekeeper may warn
          or block automatic update/relaunch behavior, so manual download and
          replacement remains the reliable path until Axon has an Apple
          Developer certificate, hardened runtime, and notarization.
        </p>
      </div>
    </div>
  </section>
</SiteLayout>
