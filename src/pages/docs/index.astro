---
import DocsLayout from "@layouts/DocsLayout.astro";

const quickstarts = [
    {
        href: "/docs/getting-started/installation",
        icon: "↓",
        title: "Install Axon",
        description: "Download the current desktop build for macOS, Windows, or Linux.",
    },
    {
        href: "/docs/getting-started/first-project",
        icon: "⌘",
        title: "Open a project",
        description: "Load a real workspace and learn the core editor flow.",
    },
    {
        href: "/docs/language-servers",
        icon: "{}",
        title: "Language tooling",
        description: "Review the bundled and managed servers Axon uses for code intelligence.",
    },
    {
        href: "/docs/features/editor",
        icon: "▦",
        title: "Editor features",
        description: "Understand panes, files, problems, previews, search, and terminal workflows.",
    },
    {
        href: "/docs/customization/settings",
        icon: "◐",
        title: "Customize Axon",
        description: "Configure settings, themes, keybindings, and extension behavior.",
    },
    {
        href: "/docs/updates",
        icon: "↻",
        title: "Updates",
        description: "Track release assets, platform builds, and version expectations.",
    },
];
---

<DocsLayout
    title="Documentation"
    description="Axon Editor documentation for installation, workbench features, language tooling, extensions, updates, and the local agent."
>
    <h1>Introduction</h1>

    <p class="text-lg">
        Axon is a local-first desktop code editor built for serious daily work.
    </p>

    <div class="my-10 flex max-w-3xl items-start gap-4 rounded-lg border border-axon-border bg-axon-panel px-6 py-5">
        <span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-axon-muted text-[12px] font-semibold text-axon-text">
            i
        </span>
        <p class="m-0 text-[16px] leading-7 text-axon-text">
            These docs cover installation, editor workflows, bundled language
            servers, Git and terminal behavior, extensions, releases, and the
            Axon Agent surfaces being built into the editor.
        </p>
    </div>

    <h2>Quickstart</h2>

    <p>
        Start with the pages below to get Axon installed, open a project, and
        verify the editor features that matter most.
    </p>

    <div class="my-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {quickstarts.map((item) => (
            <a
                href={item.href}
                class="group flex min-h-[11rem] flex-col rounded-lg border border-axon-border bg-axon-panel p-6 !no-underline transition duration-200 hover:border-zinc-500 hover:bg-axon-panel-soft"
            >
                <span class="flex h-9 items-center text-[24px] font-semibold leading-none text-axon-text">
                    {item.icon}
                </span>
                <h3 class="mb-0 mt-auto text-[19px] font-semibold leading-7 text-axon-text">
                    {item.title}
                </h3>
                <p class="mb-0 mt-2 text-[15px] leading-6 text-axon-muted">
                    {item.description}
                </p>
            </a>
        ))}
    </div>

    <h2>Explore</h2>

    <p>
        Use the left navigation to move through Axon’s feature docs. The right
        column tracks the current page sections when a page has headings.
    </p>

    <div class="my-8 grid gap-4 sm:grid-cols-2">
        <a href="/docs/features/axon-agent" class="rounded-lg border border-axon-border bg-axon-panel p-5 !no-underline transition duration-200 hover:border-zinc-500 hover:bg-axon-panel-soft">
            <h3 class="mt-0 text-lg font-semibold text-axon-text">Axon Agent</h3>
            <p class="mb-0 text-sm leading-6 text-axon-muted">Local agent surfaces, editor context, and planned workflow integration.</p>
        </a>
        <a href="/docs/development/building" class="rounded-lg border border-axon-border bg-axon-panel p-5 !no-underline transition duration-200 hover:border-zinc-500 hover:bg-axon-panel-soft">
            <h3 class="mt-0 text-lg font-semibold text-axon-text">Development</h3>
            <p class="mb-0 text-sm leading-6 text-axon-muted">Build Axon from source and understand the release process.</p>
        </a>
    </div>
</DocsLayout>
