---
import DocsLayout from "@layouts/DocsLayout.astro";
import Button from "@components/ui/Button.astro";
import Card from "@components/ui/Card.astro";

const highlights = [
    ["Go backend", "Project services, terminal PTYs, file watching, and release flows live outside the renderer."],
    ["Bundled LSPs", "TypeScript/TSX, Go, Rust, Python, HTML, CSS, JSON, YAML, Lua, and C/C++ tooling is documented here."],
    ["Extension path", "Built-ins, contributed views, commands, themes, icons, terminal profiles, and install state are moving through manifests."],
];
---

<DocsLayout
    title="Documentation"
    description="Axon Editor documentation for installation, workbench features, language tooling, extensions, updates, and the local agent."
>
    <h1>Documentation</h1>

    <p class="text-lg">
        Axon is a local-first desktop code editor built with Electron, React,
        TypeScript, and a Go backend. The docs cover the current workbench,
        bundled language tooling, Git and terminal flows, extension manifests,
        releases, and the Axon Agent surfaces being built into the editor.
    </p>

    <div class="my-8 grid gap-3 md:grid-cols-3">
        {highlights.map(([label, body]) => (
            <div class="rounded-lg border border-white/10 bg-[#0b0b0c] p-4 transition duration-200 hover:-translate-y-0.5 hover:border-zinc-500/60 hover:bg-[#141416]">
                <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-zinc-500">{label}</p>
                <p class="mt-2 text-sm leading-6 text-zinc-400">{body}</p>
            </div>
        ))}
    </div>

    <div class="grid gap-4 sm:grid-cols-2 my-8">
        <Card title="Getting Started" href="/docs/getting-started/installation">
            Install Axon, set up your first project, and learn the basics.
        </Card>
        <Card title="Editor Features" href="/docs/features/editor">
            Split panes, Problems, terminal sessions, Git workflows, tests, search, and previews.
        </Card>
        <Card title="Language Servers" href="/docs/language-servers">
            Bundled or managed tooling for TypeScript/TSX, Go, Rust, Python, HTML, CSS, JSON, YAML, Lua, and C/C++.
        </Card>
        <Card title="Customization" href="/docs/customization/themes">
            Themes, settings, keybindings, and extensions.
        </Card>
        <Card title="Extensions" href="/docs/extensions">
            Extension manifests, activation events, contributed views, themes, icons, and the registry model.
        </Card>
        <Card title="Updates" href="/docs/updates">
            Release assets, platform builds, update notes, and version expectations.
        </Card>
    </div>

    <div
        class="my-8 rounded-lg border border-white/10 bg-[linear-gradient(135deg,rgba(255,255,255,0.08),rgba(255,255,255,0.02))] p-6"
    >
        <h2 class="mt-0 border-0 pt-0">Quick Install</h2>
        <p>Download the latest version for your platform, then use the docs to verify language servers, terminal behavior, extensions, and updates.</p>
        <div class="mt-4 flex flex-wrap gap-3">
            <Button href="/download" variant="primary"
                >Download for macOS</Button
            >
            <Button href="/download" variant="secondary">Windows</Button>
            <Button href="/download" variant="secondary">Linux</Button>
        </div>
    </div>
</DocsLayout>
