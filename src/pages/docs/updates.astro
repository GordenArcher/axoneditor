---
import DocsLayout from "@layouts/DocsLayout.astro";
import { loadReleases } from "@data/releases";

const releases = await loadReleases();
const latestRelease = releases[0] ?? null;

const releaseSteps = [
  "Axon checks GitHub Releases for the latest published version.",
  "The app can show update state and release notes.",
  "Users choose the platform-specific artifact that matches their machine.",
  "Unsigned macOS builds may need manual replacement until signing and notarization are available.",
];
---

<DocsLayout title="Axon Update Docs" description="How Axon update checks and release downloads work.">
  <h1>Update checks use GitHub Releases</h1>
  <p>
    Axon can check release metadata and show notes, but the current distribution
    language stays conservative because macOS unsigned builds cannot guarantee
    smooth automatic replacement.
  </p>

  <div class="my-8 grid gap-0 border-y border-axon-border">
    {releaseSteps.map((step, index) => (
      <div class="grid gap-4 border-b border-axon-border py-4 last:border-b-0 md:grid-cols-[4rem_1fr]">
        <span class="font-mono text-sm text-axon-muted">0{index + 1}</span>
        <p class="m-0 leading-7 text-axon-muted">{step}</p>
      </div>
    ))}
  </div>

  <h2>macOS limitation</h2>
  <p>
    Do not treat current unsigned macOS builds as fully automatic update builds.
    Manual download and replacement remains the reliable route until Axon ships
    with an Apple Developer certificate, hardened runtime, and notarization.
  </p>

  <h2>Current release page</h2>
  <p>
    The latest shipped release is
    <span class="font-semibold text-axon-text">{latestRelease?.tag ?? "unavailable"}</span>,
    and the full page with assets and notes lives at the release route.
  </p>
  {latestRelease && (
    <p>
      <a href={`/releases/tag/${latestRelease.tag}`}>Open release page</a>
    </p>
  )}
</DocsLayout>
