---
import SiteLayout from "@layouts/SiteLayout.astro";

const releaseSteps = [
  "Axon checks GitHub Releases for the latest published version.",
  "The app can show update state and release notes.",
  "Users choose the platform-specific artifact that matches their machine.",
  "Unsigned macOS builds may need manual replacement until signing and notarization are available.",
];
---

<SiteLayout title="Axon Update Docs" description="How Axon update checks and release downloads work.">
  <section class="px-5 py-16">
    <div class="mx-auto max-w-5xl">
      <p class="text-xs font-semibold uppercase tracking-[0.24em] text-axon-cyan">Updates</p>
      <h1 class="mt-4 text-4xl font-semibold text-white md:text-5xl">Update checks use GitHub Releases</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-axon-muted">
        Axon can check release metadata and show notes, but the current
        distribution language stays conservative because macOS unsigned builds
        cannot guarantee smooth automatic replacement.
      </p>

      <div class="mt-10 grid gap-3">
        {releaseSteps.map((step, index) => (
          <div class="grid gap-4 rounded-lg border border-white/10 bg-white/[0.035] p-5 md:grid-cols-[3rem_1fr]">
            <span class="grid h-10 w-10 place-items-center rounded-lg bg-axon-cyan/12 text-sm font-semibold text-axon-cyan">
              {index + 1}
            </span>
            <p class="leading-7 text-axon-muted">{step}</p>
          </div>
        ))}
      </div>

      <div class="mt-10 rounded-lg border border-axon-amber/30 bg-axon-amber/10 p-5">
        <h2 class="text-lg font-semibold text-white">macOS limitation</h2>
        <p class="mt-3 leading-7 text-axon-muted">
          Do not treat current unsigned macOS builds as fully automatic update
          builds. Manual download and replacement remains the reliable route
          until Axon ships with an Apple Developer certificate, hardened
          runtime, and notarization.
        </p>
      </div>
    </div>
  </section>
</SiteLayout>
