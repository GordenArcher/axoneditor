---
import LanguageServerDoc from "@components/docs/LanguageServerDoc.astro";
import DocsLayout from "@layouts/DocsLayout.astro";
---

<DocsLayout title="CSS, SCSS, and Less" description="CSS-family language-server support in Axon">
  <LanguageServerDoc
    title="CSS, SCSS, and Less"
    description="Axon uses the VS Code CSS language server for stylesheet intelligence across CSS, SCSS, and Less files. It provides property completions, value suggestions, hover details, diagnostics, formatting, and symbols."
    server="vscode-css-language-server"
    delivery="bundled npm server"
    activation="Starts for .css, .scss, .sass, and .less files"
    overview={[
      "Stylesheet support is part syntax analysis and part authoring help. The server knows CSS properties, values, selectors, at-rules, variables, colors, and common preprocessor syntax.",
      "Axon should use the server for actual diagnostics and completions while keeping syntax highlighting separate. Pretty colors make a file readable, but the language server is what catches invalid properties or suggests correct values.",
      "CSS-family support also matters for HTML preview because stylesheet edits should be easy to author while the preview handles browser rendering.",
    ]}
    capabilities={[
      "Property, value, selector, at-rule, variable, and color completions.",
      "Hover details for CSS properties, values, colors, variables, and recognized browser features.",
      "Diagnostics for invalid syntax, unknown properties, malformed selectors, and stylesheet parse errors.",
      "Formatting, document symbols, color previews, and support for CSS, SCSS, Sass, and Less where the upstream server supports them.",
    ]}
    setup={[
      {
        title: "Open the project root for imports",
        body: "Relative imports, url() paths, fonts, and images depend on the workspace root. Opening the right folder helps diagnostics and preview behavior line up.",
      },
      {
        title: "Separate CSS server from Tailwind server",
        body: "The CSS server understands stylesheet syntax. Tailwind class intelligence comes from the Tailwind language server and should run alongside CSS support when the project uses Tailwind.",
      },
      {
        title: "Keep preprocessors mapped correctly",
        body: "SCSS, Sass, and Less files need their own language IDs. If Axon treats them as plaintext or plain CSS incorrectly, completions and diagnostics will be weaker.",
      },
    ]}
    packaging={[
      "The CSS server is bundled from vscode-langservers-extracted. Release builds must include the server package and runtime dependencies it imports.",
      "If production logs mention missing core-js or vscode-languageserver modules, the fix belongs in packaging/unpacked dependency configuration.",
    ]}
    troubleshooting={[
      {
        title: "Colors and properties do not autocomplete",
        body: "Check language detection first. A .scss or .less file mapped as plaintext will not receive CSS-family completions.",
      },
      {
        title: "Preview works but diagnostics do not",
        body: "The browser can render CSS while the language server is not running. Open LSP logs to confirm the CSS server started and attached to the document.",
      },
      {
        title: "Packaged builds fail but dev works",
        body: "That usually means the npm server dependency tree was available in dev node_modules but missing from packaged app resources.",
      },
    ]}
  />
</DocsLayout>
