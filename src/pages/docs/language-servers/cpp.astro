---
import LanguageServerDoc from "@components/docs/LanguageServerDoc.astro";
import DocsLayout from "@layouts/DocsLayout.astro";
---

<DocsLayout title="C and C++" description="C and C++ language-server support in Axon">
  <LanguageServerDoc
    title="C and C++"
    description="Axon uses clangd for C and C++ language intelligence. Clangd provides completions, diagnostics, hover, definitions, references, rename, document symbols, and include-aware navigation."
    server="clangd"
    delivery="managed native server"
    activation="Starts for .c, .cc, .cpp, .cxx, .h, .hpp, and related C/C++ files"
    overview={[
      "C and C++ support is only accurate when the server sees the same compiler settings the project uses. Include paths, defines, target flags, language standard, generated headers, and build configuration all affect the result.",
      "Axon can bundle clangd, but clangd still needs project metadata. The most reliable source is compile_commands.json, usually generated by CMake, Ninja, Bear, Meson, or the project's build tooling.",
      "Without compile commands, clangd may still provide syntax-level help, but definitions, diagnostics, and include resolution can be incomplete or wrong.",
    ]}
    capabilities={[
      "Completions for functions, methods, fields, namespaces, types, macros, includes, and local symbols.",
      "Hover for types, declarations, function signatures, macro expansions, and documentation where available.",
      "Diagnostics, go to definition, references, rename, document symbols, workspace symbols, and formatting where project metadata supports it.",
      "Include-aware navigation and better system/header resolution when compile commands are present.",
    ]}
    setup={[
      {
        title: "Generate compile_commands.json",
        body: "For serious C/C++ projects, generate compile_commands.json and place it at the workspace root or a location clangd can discover. This file tells clangd the exact compiler arguments for each source file.",
      },
      {
        title: "Open the build-aware root",
        body: "Open the folder that owns CMakeLists.txt, compile_commands.json, Meson files, or the build system metadata. Opening a nested source folder makes clangd guess.",
      },
      {
        title: "Keep the toolchain installed",
        body: "Axon bundles clangd, not the entire compiler toolchain. Building, testing, system headers, SDKs, and platform-specific includes still depend on the user's local setup.",
      },
    ]}
    packaging={[
      "Release builds download clangd for each target platform and package it under Axon's managed language-server resources.",
      "If packaged clangd exits immediately, check platform architecture, executable permissions, quarantine/signing behavior on macOS, and whether the wrapper path resolves to the actual clangd binary.",
    ]}
    troubleshooting={[
      {
        title: "Standard library headers are missing",
        body: "The local toolchain or SDK may not be discoverable. Bundled clangd still needs compiler and system-header context for real projects.",
      },
      {
        title: "Project includes are unresolved",
        body: "Generate or fix compile_commands.json. Header search paths usually come from compiler flags, not from the editor guessing folder names.",
      },
      {
        title: "Completions are basic",
        body: "Basic completions usually mean clangd started without the project compile database. Check LSP logs and the opened workspace root.",
      },
    ]}
  />
</DocsLayout>
