---
import LanguageServerDoc from "@components/docs/LanguageServerDoc.astro";
import DocsLayout from "@layouts/DocsLayout.astro";
---

<DocsLayout title="JSON and JSONC" description="JSON language-server support in Axon">
  <LanguageServerDoc
    title="JSON and JSONC"
    description="Axon uses the VS Code JSON language server for schema-aware editing in JSON and JSONC files. It provides validation, completions, hover, formatting, and document symbols."
    server="vscode-json-language-server"
    delivery="bundled npm server"
    activation="Starts for .json, .jsonc, and recognized JSON configuration files"
    overview={[
      "JSON support should be strict when a file is real JSON and more permissive when a file is JSONC. This distinction matters because settings files, tsconfig files, and editor configs often allow comments while data interchange JSON does not.",
      "Schema support is the main reason to use the server. When a schema matches the current file, completions become specific to the tool instead of generic key/value suggestions.",
      "Axon should avoid noisy standalone Monaco JSON errors when the language server can provide file-aware diagnostics with the correct JSON or JSONC mode.",
    ]}
    capabilities={[
      "Schema-aware completions for known configuration files.",
      "Diagnostics for syntax errors, invalid values, missing required fields, and schema mismatches.",
      "Hover details from schemas, formatting, folding, and document symbols.",
      "Correct handling for JSONC comments where the file type supports them.",
    ]}
    setup={[
      {
        title: "Use the right file language",
        body: "A plain .json file should be strict. A .jsonc file or known comment-friendly config should allow comments. Axon needs this distinction before diagnostics are meaningful.",
      },
      {
        title: "Schemas improve everything",
        body: "Package manifests, TypeScript configs, workflow files, and tool configs become much better when the server can match a schema. Without a schema, completions are necessarily generic.",
      },
      {
        title: "Settings JSON should stay editable",
        body: "Axon's own settings JSON should use the JSON language server for validation and completions instead of custom one-off parsing feedback.",
      },
    ]}
    packaging={[
      "The JSON server is bundled from vscode-langservers-extracted and should not require a global install.",
      "Production builds must preserve the server package's runtime dependencies, especially when upstream code requires files dynamically.",
    ]}
    troubleshooting={[
      {
        title: "JSON comments are marked invalid",
        body: "Check whether the file is truly JSON or JSONC. The fix may be file-language mapping, not the language server itself.",
      },
      {
        title: "Completions are generic",
        body: "The server probably does not have a matching schema for the file. Generic JSON can only suggest syntax-level structure.",
      },
      {
        title: "Release build cannot start JSON server",
        body: "Check packaged dependencies for vscode-langservers-extracted and modules it imports at runtime.",
      },
    ]}
  />
</DocsLayout>
