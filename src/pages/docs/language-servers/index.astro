---
import DocsLayout from "@layouts/DocsLayout.astro";
import { loadReleases } from "@data/releases";

const releases = await loadReleases();
const latestRelease = releases[0] ?? null;

const deliveryModels = [
  {
    title: "Bundled npm servers",
    body: "These servers ship inside the Electron application. They are started through the Node runtime that comes with Axon, and their dependencies must remain available in packaged builds because several upstream servers load files from node_modules while running.",
    examples: "TypeScript, HTML, CSS, JSON, YAML, Tailwind, Docker, Python, PHP",
  },
  {
    title: "Managed native servers",
    body: "These servers are downloaded during the release build and stored by platform and architecture. In a packaged app, Axon resolves them from resources/language-servers so users are not asked to install each server manually.",
    examples: "Go, Rust, C/C++, Java, C#, Kotlin, Lua",
  },
  {
    title: "Project runtime requirements",
    body: "Some languages need more than the language-server binary. Java and Kotlin need a JDK, C# commonly needs .NET, Rust analysis depends on Cargo metadata, C/C++ needs compile flags, and Python imports depend on the selected interpreter or virtual environment.",
    examples: "JDK, .NET SDK, Cargo, compile_commands.json, Python venv",
  },
];

const coreFlow = [
  {
    title: "Detect the workspace",
    body: "Axon looks at the opened folder and the current file types before deciding which language servers are relevant. A server should not show an endless loading state when the workspace does not contain files for that language.",
  },
  {
    title: "Resolve the server command",
    body: "For release builds, Axon first checks packaged resources. For development builds, it can use the local build/language-servers directory or fall back to a globally installed server when a generated bundle is missing.",
  },
  {
    title: "Start and attach",
    body: "The editor starts the server, connects Monaco to the language client, and forwards file changes, open documents, workspace folders, completion requests, hover requests, definitions, references, renames, and diagnostics.",
  },
  {
    title: "Report failures clearly",
    body: "When a server fails, Axon should explain whether the issue is a missing packaged dependency, a missing runtime, an invalid interpreter, an architecture mismatch, or a project configuration problem.",
  },
];

const languageGroups = [
  {
    title: "Web and configuration",
    body: "These servers cover the files most web projects touch every day. They should start quickly, avoid noisy standalone Monaco errors, and work in release builds without a global install.",
    languages: [
      {
        name: "TypeScript / JavaScript",
        href: "/docs/language-servers/typescript",
        server: "typescript-language-server with TypeScript",
        delivery: "bundled npm server",
        details: "Reads package.json, tsconfig.json, and jsconfig.json. Handles TS, JS, JSX, TSX, local types, path aliases, definitions, references, rename, hover, formatting, diagnostics, and code actions.",
      },
      {
        name: "HTML",
        href: "/docs/language-servers/html",
        server: "vscode-html-language-server",
        delivery: "bundled npm server",
        details: "Provides tag and attribute completions, hover, formatting, diagnostics, symbols, document links, and embedded CSS/JavaScript awareness for plain HTML files.",
      },
      {
        name: "CSS / SCSS / Less",
        href: "/docs/language-servers/css",
        server: "vscode-css-language-server",
        delivery: "bundled npm server",
        details: "Covers properties, values, selectors, colors, at-rules, variables, document symbols, diagnostics, hover, and formatting for stylesheet files.",
      },
      {
        name: "JSON / JSONC",
        href: "/docs/language-servers/json",
        server: "vscode-json-language-server",
        delivery: "bundled npm server",
        details: "Handles schema-aware completions, validation, hover, formatting, symbols, and the difference between strict JSON and comment-friendly JSONC files.",
      },
      {
        name: "YAML",
        href: "/docs/language-servers/yaml",
        server: "yaml-language-server",
        delivery: "bundled npm server",
        details: "Supports schema-backed completions and diagnostics for CI files, Docker Compose, deployment files, Kubernetes manifests, and project configuration.",
      },
      {
        name: "Tailwind CSS",
        href: "/docs/language-servers/tailwind",
        server: "@tailwindcss/language-server",
        delivery: "bundled npm server",
        details: "Provides utility-class completions, variants, hover previews, color previews, and diagnostics when Axon opens the folder that owns the Tailwind config.",
      },
      {
        name: "Docker",
        href: "/docs/language-servers/docker",
        server: "Docker language server",
        delivery: "bundled npm server",
        details: "Improves Dockerfile editing with instruction completions, hover, symbols, and diagnostics without requiring Docker Desktop just to parse files.",
      },
    ],
  },
  {
    title: "Application languages",
    body: "These servers depend more heavily on the actual project root. Opening the right folder matters because modules, packages, generated files, toolchains, and build metadata affect the result.",
    languages: [
      {
        name: "Python",
        href: "/docs/language-servers/python",
        server: "pyright-langserver",
        delivery: "bundled npm server",
        details: "Uses the selected interpreter or virtual environment for imports. This is what makes Django, DRF, FastAPI, NumPy, project-local packages, and venv-installed dependencies resolve correctly.",
      },
      {
        name: "Go",
        href: "/docs/language-servers/go",
        server: "gopls",
        delivery: "managed native server",
        details: "Reads go.mod, go.work, packages, generated types, and module structure. Provides completions, diagnostics, hover, definitions, references, rename, formatting, and code actions.",
      },
      {
        name: "Rust",
        href: "/docs/language-servers/rust",
        server: "rust-analyzer",
        delivery: "managed native server",
        details: "Uses Cargo metadata for project analysis. Provides completions, hover, diagnostics, definitions, references, rename, symbols, and Rust-aware semantic information.",
      },
      {
        name: "PHP",
        href: "/docs/language-servers/php",
        server: "intelephense",
        delivery: "bundled npm server",
        details: "Indexes Composer projects, namespaces, classes, framework symbols, vendor packages, and project files to provide fast completions, definitions, hover, diagnostics, and rename.",
      },
      {
        name: "Lua",
        href: "/docs/language-servers/lua",
        server: "lua-language-server",
        delivery: "managed native server",
        details: "Supports completions, diagnostics, hover, definitions, references, symbols, and runtime/library-aware editing for plain Lua and configured Lua runtimes.",
      },
    ],
  },
  {
    title: "Compiled and JVM languages",
    body: "These languages are the most sensitive to toolchain setup. Axon can bundle the server, but the project still needs the runtime or build metadata that the language ecosystem expects.",
    languages: [
      {
        name: "C / C++",
        href: "/docs/language-servers/cpp",
        server: "clangd",
        delivery: "managed native server",
        details: "Works best with compile_commands.json. Include paths, language standard, defines, target flags, and generated headers decide how accurate clangd can be.",
      },
      {
        name: "Java",
        href: "/docs/language-servers/java",
        server: "Eclipse JDT Language Server",
        delivery: "managed native server with local JDK requirement",
        details: "Needs a local JDK for serious projects. Maven, Gradle, source roots, imports, generated files, diagnostics, symbols, rename, formatting, and build-aware behavior depend on the project setup.",
      },
      {
        name: "C#",
        href: "/docs/language-servers/csharp",
        server: "OmniSharp",
        delivery: "managed native server with local .NET requirement",
        details: "Uses solution and project files to understand references, target frameworks, package restore, diagnostics, completions, hover, definitions, references, rename, and formatting.",
      },
      {
        name: "Kotlin",
        href: "/docs/language-servers/kotlin",
        server: "kotlin-language-server",
        delivery: "managed native server with local JDK requirement",
        details: "Works best from the Gradle or Maven project root. The local JDK and project metadata help the server resolve source sets, dependencies, generated code, and symbols.",
      },
    ],
  },
];

const troubleshooting = [
  {
    title: "It works in dev but not in the installed app",
    body: "Check packaging first. Native servers must exist under resources/language-servers for the current platform and architecture. npm servers must have their runtime dependencies unpacked when the upstream package requires files dynamically.",
  },
  {
    title: "Completions are too basic",
    body: "Open the actual project root and make sure dependency installation has happened. For TypeScript this means package dependencies and tsconfig/jsconfig. For Go this means go.mod or go.work. For Python this means selecting the interpreter when external packages live in a venv.",
  },
  {
    title: "The server starts but imports are missing",
    body: "That is usually a project-model issue, not a UI issue. Python needs the right interpreter, C/C++ needs compiler flags, Java/Kotlin need a JDK and build files, C# needs the .NET project graph, and Rust needs Cargo metadata.",
  },
];
---

<DocsLayout title="Axon Language Server Docs" description="Axon language-server support, bundled server behavior, and runtime requirements.">
  <section>
    <header>
      <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.16em] text-zinc-500">Language servers</p>
      <h1>Axon is an LSP client</h1>
      <p>
        Axon uses language servers for completions, diagnostics, hover,
        definitions, references, rename, formatting, code actions, and project
        symbols. The editor does not fake language intelligence in the UI,
        because each language has its own compiler rules, module system,
        runtime, package manager, and project layout.
      </p>
      <p>
        The important part is consistency. A language server that works in
        development should work in the packaged app, and a server that cannot
        start should explain the real reason instead of leaving the user with a
        permanent loading state. Axon treats language-server startup, logs,
        packaging, runtime requirements, and workspace detection as editor
        infrastructure, not as optional polish.
      </p>
    </header>

    <section>
      <h2>How the language-server flow works</h2>
      <p>
        Every supported language follows the same high-level flow. The details
        change per language, but the editor should always make the state clear:
        relevant, starting, running, failed with a useful reason, or not needed
        for the current workspace.
      </p>

      <div class="my-6 grid gap-4 md:grid-cols-2">
        {coreFlow.map((item, index) => (
          <article class="group rounded-lg border border-white/10 bg-[#0b0b0c] p-5 transition duration-200 hover:-translate-y-0.5 hover:border-zinc-500/60 hover:bg-[#141416]">
            <span class="font-mono text-xs text-zinc-500 transition group-hover:text-zinc-300">{String(index + 1).padStart(2, "0")}</span>
            <h3 class="mt-4 text-base font-semibold text-zinc-100">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-zinc-400">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section>
      <h2>Server delivery model</h2>
      <p>
        Axon uses two delivery models because not every language server is
        packaged the same way upstream. The docs separate them so release
        issues are easier to reason about when a server behaves differently in
        development and production.
      </p>

      <div class="my-6 grid gap-4 md:grid-cols-2">
        {deliveryModels.map((item) => (
          <article class="rounded-lg border border-white/10 bg-[#0b0b0c] p-5 transition duration-200 hover:-translate-y-0.5 hover:border-zinc-500/60 hover:bg-[#141416]">
            <h3 class="text-base font-semibold text-zinc-100">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-zinc-400">{item.body}</p>
            <div class="mt-4 rounded-md border border-white/10 bg-black p-3">
              <span class="block text-[11px] font-semibold uppercase tracking-[0.16em] text-zinc-500">Examples</span>
              <strong class="mt-1 block text-sm font-medium text-zinc-200">{item.examples}</strong>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section>
      <h2>Supported languages</h2>
      <p>
        This is the full language-server list currently documented for Axon.
        Each language links to a dedicated page with setup notes, expected
        editor behavior, and the project shape that gives the server the best
        result.
      </p>

      <div class="my-6 grid gap-8">
        {languageGroups.map((group) => (
          <section class="rounded-lg border border-white/10 bg-[#070707] p-5">
            <div class="grid gap-2 md:grid-cols-[14rem_1fr] md:items-start">
              <h3 class="text-base font-semibold text-zinc-100">{group.title}</h3>
              <p class="text-sm leading-6 text-zinc-400">{group.body}</p>
            </div>
            <div class="mt-5 grid gap-3 md:grid-cols-2">
              {group.languages.map((item) => (
                <a href={item.href} class="group rounded-lg border border-white/10 bg-[#0b0b0c] p-4 no-underline transition duration-200 hover:-translate-y-0.5 hover:border-zinc-500/60 hover:bg-[#141416]">
                  <div>
                    <span class="text-[10px] font-semibold uppercase tracking-[0.16em] text-zinc-500">{item.delivery}</span>
                    <h4 class="mt-2 text-base font-semibold text-zinc-100 transition group-hover:text-white">{item.name}</h4>
                    <p class="mt-1 font-mono text-xs text-zinc-500">{item.server}</p>
                  </div>
                  <p class="mt-3 text-sm leading-6 text-zinc-400">{item.details}</p>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>

    <section>
      <h2>Release packaging</h2>
      <p>
        Official GitHub release assets include matching managed server bundles
        per platform under
        <code>editor/build/language-servers/&lt;platform&gt;-&lt;arch&gt;</code>
        during the build process, then package them into the desktop app under
        application resources. Users downloading release builds should not need
        Axon to redownload those managed server binaries on first run.
      </p>
      <p>
        Development builds are different. A fresh clone may not have
        <code>editor/build/language-servers</code> populated because those
        binaries are generated artifacts. In that case development mode can
        fall back to globally installed servers, but the correct release test
        is to run the language-server build step and verify the same resolver
        path production uses.
      </p>
      <p>
        The current release line is
        <strong>{latestRelease?.tag ?? "the latest Axon release"}</strong>.
        Language-server quality should be checked against both dev mode and
        packaged builds before a release is considered stable.
      </p>
    </section>

    <section>
      <h2>Troubleshooting checklist</h2>
      <div class="my-6 grid gap-4 md:grid-cols-2">
        {troubleshooting.map((item) => (
          <article class="rounded-lg border border-white/10 bg-[#0b0b0c] p-5 transition duration-200 hover:-translate-y-0.5 hover:border-zinc-500/60 hover:bg-[#141416]">
            <h3 class="text-base font-semibold text-zinc-100">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-zinc-400">{item.body}</p>
          </article>
        ))}
      </div>
    </section>
  </section>
</DocsLayout>
