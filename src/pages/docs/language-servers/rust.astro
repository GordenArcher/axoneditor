---
import LanguageServerDoc from "@components/docs/LanguageServerDoc.astro";
import DocsLayout from "@layouts/DocsLayout.astro";
---

<DocsLayout title="Rust" description="Rust language-server support in Axon">
  <LanguageServerDoc
    title="Rust"
    description="Axon uses rust-analyzer for Rust language intelligence. Rust-analyzer provides completions, diagnostics, hover, definitions, references, rename, symbols, and Cargo-aware project analysis."
    server="rust-analyzer"
    delivery="managed native server"
    activation="Starts for .rs files and Rust workspaces with Cargo.toml"
    overview={[
      "Rust support depends heavily on Cargo metadata. The server needs to understand the workspace manifest, crates, features, proc macros, dependencies, target settings, and source layout before completions and diagnostics feel complete.",
      "Axon bundles rust-analyzer as a managed native server in release builds. The Rust toolchain is still useful because projects often need cargo metadata, cargo check behavior, build scripts, procedural macros, and target-specific information.",
      "The best user experience comes from opening the repository or crate root that owns Cargo.toml. Opening only a nested src folder can make the current file look detached from its crate.",
    ]}
    capabilities={[
      "Completions for variables, functions, methods, traits, modules, associated items, fields, macros, and imported symbols.",
      "Hover for inferred types, trait bounds, signatures, documentation comments, module paths, and macro information where available.",
      "Definitions, references, rename, diagnostics, document symbols, workspace symbols, formatting hooks, and Cargo-aware project analysis.",
      "Better behavior for workspaces, crates, features, proc macros, and generated code when Cargo metadata is available.",
    ]}
    setup={[
      {
        title: "Open the Cargo root",
        body: "Open the folder that contains Cargo.toml or the repository root that owns the Cargo workspace. Rust-analyzer uses that manifest to understand crates, dependencies, features, and source ownership.",
      },
      {
        title: "Keep the Rust toolchain installed",
        body: "The language server can be bundled, but real Rust projects still benefit from rustup, cargo, rustc, and target toolchains. Without them, metadata and build-script behavior can be incomplete.",
      },
      {
        title: "Expect indexing time on large workspaces",
        body: "Rust-analyzer can take time to index big workspaces. Axon should show useful server status without blocking editor input while the server builds its model.",
      },
    ]}
    packaging={[
      "Release builds download rust-analyzer for the target platform and package it under the managed language-server resources path.",
      "If release builds fail while development works, check platform architecture, executable permissions, and whether Axon is resolving the packaged binary instead of falling back to a globally installed rust-analyzer.",
    ]}
    troubleshooting={[
      {
        title: "Completions are missing crate symbols",
        body: "Confirm the opened folder owns Cargo.toml, dependencies are available, and Cargo metadata can run. Workspace or feature issues often show up as incomplete symbols.",
      },
      {
        title: "Proc macro or build script diagnostics look wrong",
        body: "Install the required Rust toolchain and targets. Bundling rust-analyzer does not replace project-specific toolchain requirements.",
      },
      {
        title: "Server status is running but behavior is weak",
        body: "Check LSP logs for cargo metadata failures. A server can run successfully but still lack project context if Cargo fails underneath it.",
      },
    ]}
  />
</DocsLayout>
