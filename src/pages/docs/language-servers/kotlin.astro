---
import LanguageServerDoc from "@components/docs/LanguageServerDoc.astro";
import DocsLayout from "@layouts/DocsLayout.astro";
---

<DocsLayout title="Kotlin" description="Kotlin language-server support in Axon">
  <LanguageServerDoc
    title="Kotlin"
    description="Axon bundles Kotlin language-server support for Kotlin source files. It provides completions, diagnostics, hover, definitions, references, and symbols when the project model can be read."
    server="kotlin-language-server"
    delivery="managed native server with local JDK requirement"
    activation="Starts for .kt and .kts files"
    overview={[
      "Kotlin support depends on JVM project metadata. Gradle, Maven, source sets, dependencies, generated files, Kotlin compiler settings, and the local JDK affect the quality of language intelligence.",
      "Bundling the server helps Axon start Kotlin support without asking users to install the server globally, but a local JDK and real project build setup are still needed for serious projects.",
      "Kotlin projects should be opened at the Gradle or Maven root so the server can understand source sets and dependencies instead of treating one file in isolation.",
    ]}
    capabilities={[
      "Completions for classes, functions, properties, methods, imports, packages, and project symbols.",
      "Hover for types, function signatures, documentation, inferred values, and declarations.",
      "Diagnostics, definitions, references, document symbols, workspace symbols, and project-aware Kotlin editing where the server supports them.",
      "Better dependency and source-set awareness when Gradle or Maven project metadata is available.",
    ]}
    setup={[
      {
        title: "Install a JDK",
        body: "Kotlin projects usually run on the JVM. The server can be bundled, but the local JDK is still needed for project analysis and build-tool behavior.",
      },
      {
        title: "Open the Gradle or Maven root",
        body: "Open the folder that owns build.gradle, settings.gradle, pom.xml, or the project metadata. This helps the server resolve dependencies and source sets.",
      },
      {
        title: "Expect project-model limits",
        body: "Kotlin language-server support can vary by project shape. Axon should expose logs clearly when the server cannot load Gradle or Maven metadata.",
      },
    ]}
    packaging={[
      "Kotlin language-server is bundled as a managed server in release builds.",
      "Packaged Axon still needs to detect and report missing JDK/project-model problems separately from missing server binary problems.",
    ]}
    troubleshooting={[
      {
        title: "Server starts but project symbols are missing",
        body: "Check that Axon opened the build root and that the local JDK is available. Missing project metadata usually weakens completions.",
      },
      {
        title: "Gradle project does not resolve",
        body: "Check LSP logs for Gradle import errors and verify the project can load from the command line.",
      },
      {
        title: "Only syntax-level help appears",
        body: "The file may be detached from its source set. Open the root that owns the Kotlin project files.",
      },
    ]}
  />
</DocsLayout>
