---
import SiteLayout from "@layouts/SiteLayout.astro";
import { loadReleases } from "@data/releases";

const releases = await loadReleases();
const latestRelease = releases[0] ?? null;

const servers = [
  ["TypeScript / JavaScript", "bundled", "typescript-language-server"],
  ["Go", "managed", "gopls"],
  ["Python", "bundled", "pyright-langserver"],
  ["Rust", "managed", "rust-analyzer"],
  ["C / C++", "managed", "clangd"],
  ["Java", "managed", "jdtls; local JDK required"],
  ["C#", "managed", "OmniSharp; local .NET requirement applies"],
  ["Kotlin", "managed", "kotlin-language-server; local JDK required"],
  ["PHP", "bundled", "intelephense"],
  ["Lua", "managed", "lua-language-server"],
  ["Docker", "bundled", "Docker language server"],
  ["Tailwind CSS", "bundled", "Tailwind language server"],
];
---

<SiteLayout title="Axon Language Server Docs" description="Axon language-server support, bundled server behavior, and runtime requirements.">
  <section class="px-5 py-16 md:py-20">
    <div class="mx-auto max-w-6xl">
      <p class="text-xs font-semibold uppercase text-axon-muted">Language servers</p>
      <h1 class="mt-4 text-4xl font-semibold leading-tight text-zinc-100 md:text-6xl">Axon is an LSP client</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-axon-muted">
        Axon talks to language servers for completions, diagnostics, hover,
        definitions, references, rename, formatting, and code actions. It does
        not reimplement language type systems or import resolution itself.
      </p>

      <div class="release-row mt-10">
        <h2 class="text-lg font-semibold text-zinc-100">Current QA status</h2>
        <p class="mt-3 leading-7 text-axon-muted">
          The {latestRelease?.tag ?? "latest"} foundation exists, including Python environment settings,
          LSP restart controls, and logs in the Output panel. Full hover,
          go-to, rename, and formatting QA across every supported language is
          still an active follow-up before claiming every language is rock solid.
        </p>
      </div>

      <div class="mt-10 overflow-hidden border-y border-white/10">
        {servers.map(([language, status, note]) => (
          <div class="grid gap-2 border-b border-white/10 py-5 last:border-b-0 md:grid-cols-[0.35fr_0.2fr_1fr]">
            <span class="font-semibold text-zinc-100">{language}</span>
            <span class="text-sm uppercase text-axon-muted">{status}</span>
            <span class="text-sm leading-6 text-axon-muted">{note}</span>
          </div>
        ))}
      </div>

      <h2 class="mt-12 text-2xl font-semibold text-zinc-100">Release packaging</h2>
      <p class="mt-4 max-w-3xl leading-7 text-axon-muted">
        GitHub release assets include matching managed language-server bundles
        per platform under
        <code class="mx-1 rounded bg-black/30 px-1.5 py-0.5 text-axon-muted">editor/build/language-servers/&lt;platform&gt;-&lt;arch&gt;</code>.
        Users downloading release builds should not need Axon to redownload
        those managed server binaries on first run.
      </p>
    </div>
  </section>
</SiteLayout>
