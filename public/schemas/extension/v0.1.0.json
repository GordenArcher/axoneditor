{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axoneditor.com/schemas/extension/v0.1.0.json",
  "title": "Axon Extension Manifest",
  "description": "Schema for axon.extension.json files loaded by Axon.",
  "type": "object",
  "required": ["id", "name", "publisher", "version"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
      "description": "Stable extension id. Use a reverse-domain or publisher-prefixed id."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string"
    },
    "author": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": ["name"],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      ]
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "activationEvents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "themes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/theme"
          }
        },
        "languages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/language"
          }
        },
        "snippets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/snippet"
          }
        },
        "icons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/icon"
          }
        }
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "theme": {
      "type": "object",
      "required": ["id", "label", "path"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      }
    },
    "language": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "filenames": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "configuration": {
          "type": "string"
        }
      }
    },
    "snippet": {
      "type": "object",
      "required": ["language", "path"],
      "additionalProperties": false,
      "properties": {
        "language": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      }
    },
    "icon": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        }
      }
    }
  }
}
